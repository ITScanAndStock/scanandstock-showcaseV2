{
  "name": "scanandstock-showcasev2",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node --env-file-if-exists=.env scripts/sync-notion.mjs",
    "dev": "astro dev --port 4321",
    "sync:notion": "node --env-file-if-exists=.env scripts/sync-notion.mjs",
    "prebuild": "node --env-file-if-exists=.env scripts/sync-notion.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@notionhq/client": "^2.3.0",
    "astro": "^6.3.1",
    "notion-to-md": "^3.1.9",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-unwrap-images": "^1.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
