---
/** Global CSS */
import "../styles/global.css";

/** Import Components */
import { Font } from "astro:assets";
import ThirdPartyScripts from "../components/ThirdPartyScripts.astro";
import CookieConsent from "../components/CookieConsent.astro";
import NavigationBar from "../components/NavigationBar.astro";
import Footer from "../components/Footer.astro";
import ogBanner from "../assets/og-banner.png";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

type Props = {
  title: string;
  description?: string;
  image?: ImageMetadata | string;
  type?: "website" | "article";
};

const {
  title,
  description = "Scan&Stock, le logiciel de gestion des stocks pour cabinets dentaires : gagnez du temps sur vos inventaires et vos commandes.",
  image,
  type = "website",
} = Astro.props;

// Image de partage (Open Graph) en URL absolue. Défaut = bannière PNG
// 1200×630 (les réseaux sociaux ne savent pas afficher un SVG).
const ogImageSrc =
  typeof image === "string" ? image : (image?.src ?? ogBanner.src);
const ogImageURL = new URL(ogImageSrc, Astro.site).href;

// Le staging et la démo GitHub Pages sont marqués noindex pour éviter
// l'indexation et le contenu dupliqué avec la prod (même base Notion).
const isStaging = import.meta.env.SYNC_TARGET === "staging";
const isDemo = import.meta.env.GITHUB_PAGES === "true";
const noindex = isStaging || isDemo;

// Content Security Policy (livrée via <meta>, cf. astro.config.mjs). Approche
// pragmatique : 'unsafe-inline' toléré pour script/style (requis par Tawk.to,
// Calendly et les handlers onclick), mais les origines tierces sont en
// allowlist stricte (connect/frame/form/media). Durcir plus tard en
// réécrivant les onclick en addEventListener (voir AUDIT.md § CSP).
const csp = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline' https://assets.calendly.com https://www.googletagmanager.com https://*.tawk.to",
  "style-src 'self' 'unsafe-inline' https://assets.calendly.com https://*.tawk.to",
  "img-src 'self' data: https:",
  "font-src 'self' data: https://*.tawk.to",
  "media-src 'self' https://scanandstock-media.s3.eu-west-3.amazonaws.com",
  "frame-src https://calendly.com https://*.calendly.com https://*.tawk.to https://www.youtube.com",
  "connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://calendly.com https://*.calendly.com https://*.tawk.to wss://*.tawk.to https://formspree.io",
  "form-action 'self' https://formspree.io",
  "base-uri 'self'",
  "object-src 'none'",
  "worker-src 'self' blob:",
].join("; ");
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    {
      /* CSP en production seulement : en dev, elle casserait le HMR de Vite
         (eval + websocket). Tester via `pnpm build` + `pnpm preview`. */
      import.meta.env.PROD && (
        <meta http-equiv="Content-Security-Policy" content={csp} />
      )
    }
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL}favicon.ico`}
      sizes="any"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${import.meta.env.BASE_URL}favicon-32.png`}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Scan&Stock" />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Montserrat auto-hébergée (Fonts API Astro, voir astro.config.mjs) -->
    <Font cssVariable="--font-montserrat" preload />
    <!--
      CSS Calendly chargé en non bloquant : media="print" évite que la feuille
      bloque le rendu, puis un script bundlé la repasse en media="all". Le swap
      est en JS (et non en onload="" inline) pour rester compatible avec la CSP,
      qui interdit les gestionnaires inline. La feuille n'est utile qu'à
      l'ouverture du popup Calendly (déclenchée au clic), donc jamais critique.
    -->
    <link
      id="calendly-css"
      href="https://assets.calendly.com/assets/external/widget.css"
      rel="stylesheet"
      media="print"
    />
    <script>
      const calendlyCss = document.getElementById("calendly-css");
      if (calendlyCss) (calendlyCss as HTMLLinkElement).media = "all";
    </script>

    <!-- Données structurées / balises spécifiques à la page -->
    <slot name="head" />
  </head>
  <body>
    <NavigationBar />
    <slot />
    <ThirdPartyScripts />
    <Footer />
    <CookieConsent />
  </body>
</html>
