---
/** Global CSS */
import "../styles/global.css";

/** Import Components */
import { Font } from "astro:assets";
import ThirdPartyScripts from "../components/ThirdPartyScripts.astro";
import CookieConsent from "../components/CookieConsent.astro";
import NavigationBar from "../components/NavigationBar.astro";
import Footer from "../components/Footer.astro";
import ogBanner from "../assets/og-banner.png";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

type Props = {
  title: string;
  description?: string;
  image?: ImageMetadata | string;
  type?: "website" | "article";
};

const {
  title,
  description = "Scan&Stock, le logiciel de gestion des stocks pour cabinets dentaires : gagnez du temps sur vos inventaires et vos commandes.",
  image,
  type = "website",
} = Astro.props;

// Image de partage (Open Graph) en URL absolue. Défaut = bannière PNG
// 1200×630 (les réseaux sociaux ne savent pas afficher un SVG).
const ogImageSrc =
  typeof image === "string" ? image : (image?.src ?? ogBanner.src);
const ogImageURL = new URL(ogImageSrc, Astro.site).href;

// Le staging et la démo GitHub Pages sont marqués noindex pour éviter
// l'indexation et le contenu dupliqué avec la prod (même base Notion).
const isStaging = import.meta.env.SYNC_TARGET === "staging";
const isDemo = import.meta.env.GITHUB_PAGES === "true";
const noindex = isStaging || isDemo;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${import.meta.env.BASE_URL}favicon-32.png`}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Scan&Stock" />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Montserrat auto-hébergée (Fonts API Astro, voir astro.config.mjs) -->
    <Font cssVariable="--font-montserrat" preload />
    <!--
      CSS Calendly chargé en non bloquant : media="print" évite que la feuille
      bloque le rendu, puis un script bundlé la repasse en media="all". Le swap
      est en JS (et non en onload="" inline) pour rester compatible avec la CSP,
      qui interdit les gestionnaires inline. La feuille n'est utile qu'à
      l'ouverture du popup Calendly (déclenchée au clic), donc jamais critique.
    -->
    <link
      id="calendly-css"
      href="https://assets.calendly.com/assets/external/widget.css"
      rel="stylesheet"
      media="print"
    />
    <script>
      const calendlyCss = document.getElementById("calendly-css");
      if (calendlyCss) (calendlyCss as HTMLLinkElement).media = "all";
    </script>

    <!-- Données structurées / balises spécifiques à la page -->
    <slot name="head" />
  </head>
  <body>
    <NavigationBar />
    <slot />
    <ThirdPartyScripts />
    <Footer />
    <CookieConsent />
  </body>
</html>
