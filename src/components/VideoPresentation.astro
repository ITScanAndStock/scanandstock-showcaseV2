      >. <strong>Scan & Stock</strong> est disponible pour les cabinets dentaires,
      laboratoires de prothèses et toutes les professions médicales.
    </p>
  </div>
</section>

<style>
  /* ─── Mobile ─────────────────────────────────────────── */
  .video-section {
    width: 100%;
    max-width: 900px;
    margin: 2rem auto;
  }
  .separator {
    display: none;
  }
  .video-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .video-wrapper iframe {
    width: 100%;
    height: 100%;
    border-radius: 20px;
    border: unset;
  }
  .paragraphe {
    line-height: 30px;
    font-weight: 500;
    margin: 1rem auto;
    color: #27333a;
    font-size: 16px;
    letter-spacing: 0.5px;
  }

  /* ─── Tablet ─────────────────────────────────────────── */
  @media screen and (min-width: 768px) {
    .video-section {
      max-width: unset;
      display: flex;
      align-items: center;
      padding: 0 3rem;
    }
    .video-wrapper {
      flex: 0.7;
    }
    .separator {
      display: flex;
      width: 1px;
      height: 320px;
      border-left: 2px dashed #545d638c;
      margin: 0 40px;
    }
    .texts {
      flex: 1;
    }
  }
</style>

<script>
  const ytFrame = document.getElementById("yt-player") as HTMLIFrameElement;
  const ytWrapper = ytFrame?.closest(".video-wrapper") as HTMLElement | null;
  if (ytFrame && ytWrapper) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !ytFrame.src) {
            ytFrame.src = ytFrame.dataset.src!;
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(ytWrapper);
  }
</script>
