---
import { getImage } from "astro:assets";
import PresentationPoster from "../assets/video/poster/presentation.png";

// Vidéo hébergée sur S3 comme les autres (FeaturesTabs, témoignages).
// Ré-encodée en H.264 720p (faststart, sans audio) : ~2,4 Mo, compatible
// partout (l'ancien iframe YouTube apportait ~1 Mo de JS tiers + un traceur
// + l'overlay « lecteur média » iOS via autoplay).
const VIDEO_SRC =
  "https://scanandstock-media.s3.eu-west-3.amazonaws.com/videos/presentation_scanandstock.mp4";

// Poster optimisé via le pipeline Astro (WebP), comme les posters témoignages.
const poster = await getImage({
  src: PresentationPoster,
  format: "webp",
  width: 1280,
  height: 720,
});
---

<section class="video-section">
  <div class="video-wrapper">
    <video
      id="presentation-video"
      class="presentation-video"
      data-src={VIDEO_SRC}
      poster={poster.src}
      width="1280"
      height="720"
      muted
      loop
      playsinline
      preload="none"
      aria-label="Vidéo de présentation de Scan & Stock"></video>
  </div>

  <div class="separator"></div>
  <div class="texts">
    <p class="paragraphe">
      Au sein d'un cabinet dentaire, le poste achat doit représenter
      <strong> 5 à 7% du chiffre d'affaires</strong>, cependant peu de
      praticiens savent exactement combien représente l'achat de consommables
      dans leurs structures.
    </p>
    <p class="paragraphe">
      En utilisant un <strong>système de gestion efficace</strong> leur permettant
      de connaître leurs stocks en <strong> temps réel</strong>, les assistantes
      ou secrétaires peuvent générer leurs commandes au <strong
        >moment idéal et ainsi faire des économies sur le poste achat</strong
      >. <strong>Scan & Stock</strong> est disponible pour les cabinets dentaires,
      laboratoires de prothèses et toutes les professions médicales.
    </p>
  </div>
</section>

<style>
  /* ─── Mobile ─────────────────────────────────────────── */
  .video-section {
    width: 100%;
    max-width: 900px;
    margin: 2rem auto;
  }
  .separator {
    display: none;
  }
  .video-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .video-wrapper video {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 20px;
    border: unset;
    object-fit: cover;
    background: #000;
  }
  .paragraphe {
    font-weight: 500;
    margin: 1rem auto;
    color: var(--color-text);
    font-size: 16px;
    letter-spacing: 0.5px;
  }

  /* ─── Tablet ─────────────────────────────────────────── */
  @media screen and (min-width: 768px) {
    .video-section {
      max-width: unset;
      display: flex;
      align-items: center;
      padding: 0 3rem;
    }
    .video-wrapper {
      flex: 0.7;
    }
    .separator {
      display: flex;
      width: 1px;
      height: 400px;
      border-left: 2px dashed #545d638c;
      margin: 0 40px;
    }
    .texts {
      flex: 1;
    }
  }
</style>

<script>
  const video = document.getElementById(
    "presentation-video",
  ) as HTMLVideoElement | null;
  const wrapper = video?.closest(".video-wrapper") as HTMLElement | null;

  if (video && wrapper) {
    // Affecte le src (data-src). Avec preload="none", le navigateur ne
    // télécharge rien tant que la lecture n'est pas demandée.
    const loadSrc = () => {
      if (!video.src && video.dataset.src) video.src = video.dataset.src;
    };

    // Tactile (mobile/tablette) : pas de survol → on s'aligne sur le garde des
    // vidéos témoignages. Reduced-motion : on respecte la préférence.
    const isTouch = window.matchMedia(
      "(hover: none), (pointer: coarse)",
    ).matches;
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (isTouch || prefersReducedMotion) {
      // Pas d'autoplay : on évite de décoder une vidéo non sollicitée sur
      // mobile (cause de jank). Contrôles natifs + poster ; le src est posé
      // mais preload="none" diffère le téléchargement jusqu'au tap « play ».
      video.setAttribute("controls", "");
      loadSrc();
    } else {
      // Desktop : autoplay muet en boucle, mais uniquement quand la section
      // est visible (et pause hors écran) pour ne pas décoder en arrière-plan.
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              loadSrc();
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          });
        },
        { threshold: 0.3 },
      );
      observer.observe(wrapper);
    }
  }
</script>
