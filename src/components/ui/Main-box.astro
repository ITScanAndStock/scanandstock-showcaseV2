---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={["main-box", className]}>
  <slot />
</section>

<style>
  .main-box {
    flex-direction: column;
    justify-content: center;
    width: 100%;
    padding: 5px;
    margin: 1rem 0;
    display: flex;
    background: conic-gradient(
      from 0deg at 100% 127.59%,
      rgba(18, 161, 154, 0.26) 0deg,
      #f0f6fe 360deg
    );
    overflow: hidden;
    border-radius: 20px;
  }

  .bottom-up {
    padding-bottom: 90px;
  }
</style>
