---
// Icônes SVG inline (remplacent le kit Font Awesome → plus de script tiers
// bloquant ni de dépendance externe). Dimensionnées en 1em → pilotées par le
// `font-size` du conteneur, comme les anciennes glyphes FA. Couleur via
// `currentColor` → héritée du `color` CSS.
interface Props {
  name: "chevron-down" | "chevron-left" | "chevron-right" | "bars" | "x";
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<Props["name"], string> = {
  "chevron-down": "m6 9 6 6 6-6",
  "chevron-left": "m15 18-6-6 6-6",
  "chevron-right": "m9 18 6-6-6-6",
  bars: "M3 6h18M3 12h18M3 18h18",
  x: "M18 6 6 18M6 6l12 12",
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>

<style>
  svg {
    display: inline-block;
    vertical-align: -0.125em;
  }
</style>
