---
interface Props {
    as?: "h1" | "h2" | "h3" | "h4";
    class?: string;
}

const {as: Tag = "h2", class: className} = Astro.props;
---

<Tag class:list={["gradient-title", className]}>
    <slot/>
</Tag>

<style>
    .gradient-title {
        flex: 0.8;
        text-align: center;
        -webkit-background-clip: text;
        background-size: 1300px;
        background: linear-gradient(90deg, #12a19a 0%, #3983a3 50%, #6065ac 100%) center;
        background-clip: text;
        color: transparent;
        margin: 4rem 0;
        font-size: clamp(20px, 5vw, 38px);
        line-height: 45px;
    }

    .gradient-subtitle {
        font-size: 20px;
        text-align: start;
        margin-top: 1rem;
        flex: unset;
    }

    .gradient-title :global(.underline) {
        text-decoration: underline 3px #12a19a80;
        text-underline-offset: 5px;
    }


    .m0 {
        margin: 0;
    }

    .mv1 {
        margin: 1rem 0;
    }


</style>