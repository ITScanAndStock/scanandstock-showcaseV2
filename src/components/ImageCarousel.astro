---
import {Image} from "astro:assets";

interface Props {
    src: ImageMetadata;
    alt: string;
}

const {src: imgSources, alt} = Astro.props;
---

<figure class="image-card">
    <Image
        class="img"
        src={imgSources}
        alt={alt}
        width={800}
        height={370}
        widths={[400, 768, 1200]}
        sizes="(max-width: 768px) 92vw, 600px"
    />
</figure>

<style>
    .image-card {
        margin: 0;
        border-radius: 20px;
        overflow: hidden;
    }

    .img {
        display: block;
    }
</style>