---
import {Image} from "astro:assets";

interface Props {
    src: ImageMetadata;
    alt: string;
}

const {src: imgSources, alt} = Astro.props;
---

<figure class="image-card">
    <Image class="img" src={imgSources} alt={alt} height={370}/>
</figure>

<style>
    .image-card {
        margin: 0;
        border-radius: 20px;
        overflow: hidden;
    }

    .img {
        display: block;
    }
</style>