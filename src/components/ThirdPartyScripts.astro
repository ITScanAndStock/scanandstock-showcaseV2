<!-- Calendly : requis par les boutons « Prendre RDV » / « Réserver une démo » -->
<script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>

<!--
  Ouverture des popups Calendly par délégation d'évènement. Remplace les
  anciens gestionnaires inline (incompatibles avec la CSP : Astro ne peut pas
  les hasher). Ce script bundlé est hashé par Astro donc autorisé ; les boutons
  portent l'attribut data-calendly-url.
-->
<script>
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const trigger = target.closest<HTMLElement>("[data-calendly-url]");
    if (!trigger) return;
    const url = trigger.dataset.calendlyUrl;
    const calendly = (
      window as unknown as {
        Calendly?: { initPopupWidget(opts: { url: string }): void };
      }
    ).Calendly;
    if (url && calendly) {
      event.preventDefault();
      calendly.initPopupWidget({ url });
    }
  });
</script>
