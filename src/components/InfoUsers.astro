---
import { Image } from "astro:assets";
import Profile from "../assets/icones/profil.png";
import Boxes from "../assets/icones/box-and-click.png";
import Order from "../assets/icones/order.png";
---

<section>
  <article>
    <Image src={Profile} alt="icone utilisateur" width={55} height={55} />
    <p class="number">+ 1047</p>
    <p>Utilisateurs</p>
  </article>
  <article>
    <Image
      src={Boxes}
      alt="icone d'un carton avec un curseur"
      width={55}
      height={55}
    />
    <p class="number">+ 240 000</p>
    <p>Produits</p>
  </article>
  <article>
    <Image src={Order} alt="icone d'ordinateur" width={55} height={55} />
    <p class="number">24 720</p>
    <p>Commandes</p>
  </article>
</section>

<style>
  section {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding: 30px;
    width: 100%;
    background: linear-gradient(
      270deg,
      var(--color-primary) -4.3%,
      var(--color-secondary) 51.09%,
      var(--color-tertiary) 106.47%
    );
    border-radius: 20px;
    z-index: 1;
  }

  article {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 200px;
    background: white;
    border-radius: 24px;
  }
  p {
    font-weight: 700;
  }
  article p:first-of-type {
    color: var(--color-primary);
  }

  @media screen and (min-width: 768px) {
    section {
      flex-direction: row;
      width: 90%;
      margin: -110px auto;
    }
  }

  @media screen and (min-width: 1024px) {
    section {
      width: 80%;
    }
  }
</style>
