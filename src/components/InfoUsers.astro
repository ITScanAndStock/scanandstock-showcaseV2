---
import { Image } from "astro:assets";
import HeroBox from "./ui/Hero-box.astro";
import Profile from "../assets/icones/profil.png";
import Boxes from "../assets/icones/box-and-click.png";
import Order from "../assets/icones/order.png";
---

<section>
  <article>
    <Image src={Profile} alt="icone d'utilisateur" width={55} height={55} />
    <p class="number">+ 1047</p>
    <p>Utilisateurs</p>
  </article>
  <article>
    <Image src={Boxes} alt="icone d'utilisateur" width={55} height={55} />
    <p class="number">+ 240 000</p>
    <p>Produits</p>
  </article>
  <article>
    <Image src={Order} alt="icone d'utilisateur" width={55} height={55} />
    <p class="number">24 720</p>
    <p>Commandes</p>
  </article>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding: 30px;
    width: 100%;
    background: linear-gradient(
      270deg,
      #12a19a -4.3%,
      #3983a3 51.09%,
      #496f7f 106.47%
    );
    border-radius: 20px;
  }

  article {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 200px;
    background: white;
    border-radius: 24px;
  }
  p {
    font-weight: 700;
  }
  article p:first-of-type {
    color: #12a19a;
  }

  @media screen and (min-width: 768px) {
    section {
      flex-direction: row;
      width: 90%;
      margin: -110px auto;
    }
  }

  @media screen and (min-width: 1024px) {
    section {
      width: 80%;
    }
  }
</style>
