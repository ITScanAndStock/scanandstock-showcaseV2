---
import type { Categorie } from "../data/articles";

interface Props {
  categories: Categorie[];
}

const { categories } = Astro.props;
---

<div class="filters" role="group" aria-label="Filtrer les articles par catégorie">
  <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">
    Tous
  </button>
  {
    categories.map((cat) => (
      <button type="button" class="filter" data-filter={cat} aria-pressed="false">
        {cat}
      </button>
    ))
  }
</div>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    width: fit-content;
    max-width: 100%;
    margin: 1.5rem auto 2.5rem;
    padding: 0.75rem 1.25rem;
    background-color: rgba(65, 119, 140, 0.65);
    border-radius: 62px;
  }

  .filter {
    background-color: #fff;
    border: none;
    border-radius: 200px;
    padding: 0.4rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #27333a;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .filter:hover {
    background-color: #e8f0f5;
  }

  .filter.is-active {
    background-color: #12a19a;
    border-color: #12a19a;
    color: #fff;
  }

  .filter:focus-visible {
    outline: 3px solid #12a19a;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .filter {
      transition: none;
    }
  }
</style>
