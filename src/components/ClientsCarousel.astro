---
import { Image } from "astro:assets";
import GradientTitle from "./ui/GradientTitle.astro";
import Laulan from "../assets/photos/Camille_LAULAN.jpg";
import Dischant from "../assets/photos/Claire_DISCHANT.png";
import Raux from "../assets/photos/Frederic_RAUX.png";
import Toth from "../assets/photos/Kevin_TOTH.png";
import Camaleonte from "../assets/photos/Gregory_CAMALEONTE.jpg";
import Colin from "../assets/photos/Matthieu_COLIN.png";

const clients = [
  { src: Laulan, alt: "Camille Laulan" },
  { src: Dischant, alt: "Claire Dischant" },
  { src: Raux, alt: "Frédéric Raux" },
  { src: Toth, alt: "Kevin Toth", class: "card--lower" },
  { src: Camaleonte, alt: "Grégory Camaleonte" },
  { src: Colin, alt: "Matthieu Colin", class: "card--lower" },
];
---

<section class="clients">
  <GradientTitle>Ils utilisent Scan&amp;Stock</GradientTitle>
  <div class="carousel">
    <div class="group">
      {
        clients.map((c) => (
          <Image
            draggable="false"
            class:list={["card", c.class]}
            src={c.src}
            alt={c.alt}
            width={110}
            height={110}
            densities={[1, 2]}
          />
        ))
      }
    </div>
    <div aria-hidden="true" class="group">
      {
        clients.map((c) => (
          <Image
            draggable="false"
            class:list={["card", c.class]}
            src={c.src}
            alt=""
            width={110}
            height={110}
            densities={[1, 2]}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .clients {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 0;
    gap: 10px;
  }

  .carousel {
    position: relative;
    margin: 4rem 0;
    display: flex;
    overflow: hidden;
    flex: 1;
  }

  /* Fondu des bords par dégradés superposés (couleur de la MainBox).
       Remplace mask-image : sur iOS Safari, un masque CSS au-dessus d'un
       contenu animé en continu ne se repeint pas (couche de compositing GPU
       figée) — même famille de bug que le backdrop-filter des vidéos
       témoignages. position:absolute → ces pseudo-éléments ne comptent pas
       comme items du flex container. */
  .carousel::before,
  .carousel::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 15%;
    z-index: 1;
    pointer-events: none;
  }

  .carousel::before {
    left: 0;
    background: linear-gradient(to right, #f0f6fe, rgba(240, 246, 254, 0));
  }

  .carousel::after {
    right: 0;
    background: linear-gradient(to left, #f0f6fe, rgba(240, 246, 254, 0));
  }

  .group {
    display: flex;
    align-items: center;
    /* flex-start (pas center) : center est le déclencheur du chevauchement sur
       WebKit si le groupe se comprime — les cartes débordent vers le milieu.
       Inutile ici (le contenu dupliqué est toujours plus large que le viewport). */
    justify-content: flex-start;
    gap: 2em;
    padding-right: 1em;
    /* Garantit la géométrie du marquee : les deux groupes ne se compriment pas
       (WebKit peut comprimer sous le min-content), le translate -100%
       correspond exactement à une largeur de groupe. */
    flex-shrink: 0;
    min-width: max-content;
    will-change: transform;
    animation: spin 60s infinite linear;
  }

  .card {
    flex: 0 0 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
  }

  .card--lower {
    object-position: center 10%;
  }

  /* transform: translateX plutôt que la propriété individuelle `translate`
       (avec %), mieux supportée et plus stable sur iOS Safari. */
  @keyframes spin {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  @media screen and (min-width: 768px) {
    .clients {
      flex-direction: row;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .group {
      animation: none;
      will-change: auto;
    }
  }
</style>
