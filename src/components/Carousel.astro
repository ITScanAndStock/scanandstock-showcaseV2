---
import ReserveButton from "./ReserveButton.astro";

interface Props {
    label?: string;
    withReserve?: boolean;
    variant?: 'card' | 'image';
}

const {label = "Carousel de présentation", withReserve = false, variant = 'card'} = Astro.props;
---

<section class:list={["carousel-section", `carousel-section--${variant}`]} aria-label={label}>
    <div
            class="carousel-container"
            role="group"
            aria-roledescription="carrousel"
    >
        <ol class="carousel-track" aria-live="polite">
            <slot/>
        </ol>
    </div>

    <div class="carousel-controls">
        {withReserve && (
                <div class="carousel-reserve">
                    <ReserveButton class="dark"/>
                </div>
        )}

        <div class="carousel-nav">
            <button class="carousel-btn carousel-btn--prev" aria-label="Diapositive précédente" type="button">
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            </button>
            <button class="carousel-btn carousel-btn--next" aria-label="Diapositive suivante" type="button">
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</section>

<style>
    .carousel-section {
        width: 100%;
        margin: 2rem 0;
    }

    .carousel-container {
        position: relative;
        overflow: hidden;
        width: 100%;
    }

    /* Dégradé sur le bord droit — révèle le début de la card suivante */
    .carousel-container::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 80px;
        height: 100%;
        background: linear-gradient(to right, transparent, #f0f6fe);
        pointer-events: none;
        z-index: 2;
    }

    .carousel-track {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
        transition: transform 0.4s ease;
    }

    /* ─── Variant card (défaut) ───────────────────────────── */
    :global(.carousel-section--card .carousel-slide) {
        flex: 0 0 90%;
        width: 90%;
        padding: 1rem;
    }

    /* ─── Variant image — largeur naturelle ──────────────── */
    :global(.carousel-section--image .carousel-slide) {
        flex: 0 0 auto;
        width: auto;
        padding: 0 0.5rem;
    }

    /* ─── Zone sous les cards ─────────────────────────────── */
    .carousel-controls {
        display: flex;
        flex-direction: column-reverse;
        align-items: center;
        margin-top: 2rem;
        min-height: 52px;
    }

    @media screen and (min-width: 1024px) {
        .carousel-controls {
            display: flex;
            flex-direction: row;
            align-items: center;
            padding: 0 1rem;
            margin-top: 2rem;
            min-height: 52px;
        }
    }

    /* Centré par rapport à la largeur totale de la section */
    .carousel-reserve {
        margin-top: 2rem;
    }

    @media screen and (min-width: 1024px) {
        .carousel-reserve {
            position: absolute;
            right: 50%;
            transform: translateX(50%);
            margin-top: unset;
        }
    }


    /* ─── Pilule de navigation ────────────────────────────── */
    .carousel-nav {
        background: #476E7E;
        border-radius: 75px;
        overflow: hidden;
        display: flex;
        align-items: center;
        padding: 0 4px;
        gap: 0;
        margin-right: auto;
        margin-left: auto;


    }

    @media screen and (min-width: 1024px) {
        .carousel-nav {
            gap: 0.5rem;
            margin-right: unset;
        }
    }

    .carousel-btn {
        background: transparent;
        border: none;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: white;
        font-size: 1rem;
        transition: opacity 0.15s ease;
        border-radius: 75px;
    }

    .carousel-btn:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .carousel-btn:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px #476E7E,
        0 0 0 4px white;
    }

    @media screen and (min-width: 1024px) {
        .carousel-btn {
            width: 52px;
            height: 52px;
            font-size: 1.1rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .carousel-track {
            transition: none;
        }
    }

    @media (forced-colors: active) {
        .carousel-nav {
            background: ButtonFace;
            border: 2px solid ButtonText;
        }

        .carousel-btn {
            color: ButtonText;
        }

        .carousel-btn:hover,
        .carousel-btn:focus-visible {
            background: Highlight;
            color: HighlightText;
        }

        .carousel-btn:focus-visible {
            box-shadow: 0 0 0 2px ButtonFace,
            0 0 0 4px Highlight;
        }
    }
</style>

<script is:inline>
    (function () {
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        document.querySelectorAll(".carousel-section").forEach(function (section) {
            const track = section.querySelector(".carousel-track");
            const btnPrev = section.querySelector(".carousel-btn--prev");
            const btnNext = section.querySelector(".carousel-btn--next");

            if (!track || !btnPrev || !btnNext) return;

            const slides = Array.from(section.querySelectorAll(".carousel-slide"));
            const total = slides.length;
            if (total === 0) return;

            // Clone la première slide à la fin pour l'effet de peek sur la dernière
            const firstClone = slides[0].cloneNode(true);
            firstClone.setAttribute("aria-hidden", "true");
            firstClone.removeAttribute("aria-label");
            firstClone.dataset.clone = "true";
            track.appendChild(firstClone);

            let currentIndex = 0;
            let autoplayTimer = null;

            // Initialiser les attributs ARIA sur les vraies slides
            slides.forEach(function (slide, i) {
                slide.setAttribute("role", "group");
                slide.setAttribute("aria-roledescription", "diapositive");
                slide.setAttribute("aria-label", (i + 1) + " sur " + total);
                slide.setAttribute("aria-hidden", i !== 0 ? "true" : "false");
            });

            let isAnimating = false;

            function goTo(n) {
                if (isAnimating) return;
                isAnimating = true;
                currentIndex = n;

                // Recalcul offsetLeft à chaque appel — tient compte des images chargées après init
                const allSlides = Array.from(track.querySelectorAll(".carousel-slide"));
                const target = allSlides[n];
                const offset = target ? target.offsetLeft : 0;
                track.style.transform = "translateX(-" + offset + "px)";

                // Mise à jour ARIA uniquement sur les vraies slides
                const realIndex = ((n % total) + total) % total;
                slides.forEach(function (slide, i) {
                    slide.setAttribute("aria-hidden", i !== realIndex ? "true" : "false");
                });

                // Fallback si transitionend ne se déclenche pas (reduced motion, transition: none)
                if (reduced) isAnimating = false;
            }

            // Après la transition vers le clone, revenir silencieusement à la slide 0
            track.addEventListener("transitionend", function () {
                if (currentIndex === total) {
                    track.style.transition = "none";
                    currentIndex = 0;
                    track.style.transform = "translateX(0)";
                    requestAnimationFrame(function () {
                        requestAnimationFrame(function () {
                            track.style.transition = "transform 0.4s ease";
                        });
                    });
                }
                isAnimating = false;
            });

            function goNext() {
                goTo(currentIndex + 1);
            }

            function goPrev() {
                goTo(((currentIndex - 1) % total + total) % total);
            }

            btnNext.addEventListener("click", goNext);
            btnPrev.addEventListener("click", goPrev);

            function startAutoplay() {
                if (reduced) return;
                autoplayTimer = setInterval(goNext, 5000);
            }

            function stopAutoplay() {
                if (autoplayTimer !== null) {
                    clearInterval(autoplayTimer);
                    autoplayTimer = null;
                }
            }

            const container = section.querySelector(".carousel-container");
            container.addEventListener("mouseenter", stopAutoplay);
            container.addEventListener("mouseleave", startAutoplay);
            container.addEventListener("focusin", stopAutoplay);
            container.addEventListener("focusout", startAutoplay);

            let touchStartX = 0;
            container.addEventListener("touchstart", function (e) {
                touchStartX = e.changedTouches[0].clientX;
            }, {passive: true});
            container.addEventListener("touchend", function (e) {
                const delta = e.changedTouches[0].clientX - touchStartX;
                if (Math.abs(delta) > 50) {
                    delta < 0 ? goNext() : goPrev();
                }
            }, {passive: true});

            goTo(0);
            startAutoplay();
        });
    })();
</script>