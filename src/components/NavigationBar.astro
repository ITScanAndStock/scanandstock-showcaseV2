---
const { pathname } = Astro.url;
const links = [
  { href: "/", label: "Accueil", internal: true },
  {
    href: "https://shop.myscanandstock.fr/",
    label: "Nos offres",
    internal: false,
  },
  { href: "/about", label: "À propos", internal: true },
  { href: "/blogs", label: "Blog", internal: true },
  {
    href: "https://myscanandstock.fr/",
    label: "Mon logiciel",
    internal: false,
  },
];
---

<!-- MOBILE navigation bar -->
<div class="mobile-nav">
  <input type="checkbox" id="burger" />

  <nav class="navigation">
    <img
      class="navigation__image"
      src="/src/assets/logo.png"
      alt="Logo Scan&Stock"
    />
    <label for="burger" class="burger__btn" aria-label="menu">
      <i class="fa-solid fa-bars"></i>
    </label>
  </nav>

  <label for="burger" class="nav__overlay"></label>

  <div class="navigation__drawer">
    <label class="drawer__close" for="burger" aria-label="Fermer le menu">
      <i class="fa-solid fa-x"></i>
    </label>
    <ul class="navigation__list">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[{ active: link.internal && pathname === link.href }]}
              target={link.internal ? undefined : "_blank"}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <button
      class="navigation__calendly"
      type="button"
      onclick="Calendly.initPopupWidget({url: 'https://calendly.com/arthurscanandstock'})"
    >
      Prendre un RDV
    </button>
  </div>
</div>

<!-- DESKTOP navigation bar -->
<nav class="desktop-nav">
  <img
    class="navigation__image"
    src="/src/assets/logo.png"
    alt="Logo Scan&Stock"
  />

  <ul class="navigation__list desktop-nav__list">
    {
      links.map((link) => (
        <>
          <li>
            <a
              href={link.href}
              class:list={[{ active: link.internal && pathname === link.href }]}
              target={link.internal ? undefined : "_blank"}
            >
              {link.label === "Mon logiciel" ? (
                <img src="/src/assets/computer.svg" alt="icone d'ordinateur" />
              ) : (
                ""
              )}
              {link.label}
            </a>
          </li>
          {link.label !== "Mon logiciel" ? <div class="separator" /> : ""}
        </>
      ))
    }
  </ul>

  <button
    class="desktop-nav__calendly"
    type="button"
    onclick="Calendly.initPopupWidget({url: 'https://calendly.com/arthurscanandstock'})"
  >
    <img src="/src/assets/calendar.png" alt="icone de calendrier" />
    Prendre un RDV
  </button>
</nav>

<style>
  /* ─── SHARED ───────────────────────────────────────────  */
  .navigation,
  .desktop-nav {
    position: sticky;
    top: 0.5rem;
    justify-content: space-between;
    align-items: center;
    background:
      linear-gradient(0deg, #41778cf3, #41778cf3),
      linear-gradient(0deg, rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
    border-radius: 20px;
    color: white;
    box-shadow: #41778c 0 0 2px 1px;
    z-index: 5;
  }

  .navigation__image {
    max-height: 50px;
  }

  .navigation__list {
    display: flex;
  }

  .separator {
    height: 2rem;
    border-right: 1px solid white;
    margin: 0 15px;
  }

  /* ─── MOBILE ───────────────────────────────────────────  */
  .desktop-nav {
    display: none;
  }

  .navigation {
    display: flex;
    padding: 13px 11px 15px 11px;
  }

  #burger {
    display: none;
  }
  #burger:checked ~ .nav__overlay {
    opacity: 1;
    pointer-events: all;
  }

  #burger:checked ~ .navigation__drawer {
    transform: translateX(0);
  }

  .burger__btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    padding: 8px;
  }

  .burger__btn span {
    display: block;
    width: 28px;
    height: 3px;
    background-color: white;
    border-radius: 3px;
    transition: all ease 0.3s;
  }

  .nav__overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity ease 0.3s;
    cursor: pointer;
  }

  .navigation__drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 215px;
    height: 100vh;
    background: #41778c;
    z-index: 300;
    transform: translateX(100%);
    transition: transform ease 0.3s;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.5rem;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.3);
  }

  .navigation__list {
    flex-direction: column;
  }

  .navigation__list li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.349);
  }

  .navigation__list a {
    display: block;
    padding: 1rem 0.5rem;
    font-size: 18px;
    font-weight: 500;
    color: #f0f6fe;
    text-decoration: none;
    transition: all ease 0.2s;
    text-align: center;
  }

  .navigation__list a.active {
    font-weight: 700;
    position: relative;
  }

  .navigation__list a.active::before {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 12px;
    background: radial-gradient(
      ellipse at center,
      rgba(255, 255, 255, 0.25) 0%,
      transparent 55%
    );
    filter: blur(6px);
    z-index: -1;
  }

  .drawer__close {
    align-self: flex-end;
    font-size: 22px;
    color: white;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity ease 0.2s;
  }

  .drawer__close:hover {
    opacity: 1;
  }

  .navigation__calendly {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding: 1rem;
    background-color: white;
    border-radius: 20px;
    box-shadow: white 0 0 2px 2px;
    color: #496f7f;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    border: none;
    margin-top: 2rem;
    transition: all ease 0.3s;
  }

  .navigation__calendly:hover {
    transform: scale(0.95);
  }

  /* ─── DESKTOP ───────────────────────────────────────────  */
  @media screen and (min-width: 1024px) {
    .mobile-nav {
      display: none;
    }

    .desktop-nav {
      display: flex;
      padding: 13px 20px;
    }

    .navigation__list {
      flex-direction: row;
      align-items: center;
    }

    .desktop-nav__list li {
      border-bottom: unset;
    }

    .desktop-nav__list a {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 1rem;
      padding: unset;
    }
    .desktop-nav__list a img {
      width: 25px;
      height: 15px;
    }
    .desktop-nav__list a:hover {
      text-shadow: 0 0 15px #ffffff96;
      transform: translateY(-5px);
    }
    .desktop-nav__calendly {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0.9rem 1.1rem;
      background-color: white;
      border-radius: 20px;
      box-shadow: white 0 0 2px 2px;
      color: #496f7f;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      border: none;
      transition: transform ease 0.3s;
    }
    .desktop-nav__calendly img {
      height: 20px;
      width: auto;
    }
    .desktop-nav__calendly:hover {
      transform: scale(0.95);
    }
  }

  /* ─── WIDE DESKTOP ───────────────────────────────────────────  */

  @media screen and (min-width: 1240px) {
    .separator {
      height: 2.5rem;
      margin: 0 40px;
    }
    .desktop-nav__list a {
      font-size: 20px;
    }

    .desktop-nav__list a img {
      width: unset;
      height: unset;
    }
    .desktop-nav__calendly {
      font-size: 18px;
    }
    .desktop-nav__calendly img {
      height: 25px;
      width: auto;
    }
  }
</style>
