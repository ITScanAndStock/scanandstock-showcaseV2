---
const videos = [
  {
    key: "stock",
    label: "Stock",
    src: "https://scanandstock-media.s3.eu-west-3.amazonaws.com/videos/Video_site_1_stock.mp4",
  },
  {
    key: "commandes",
    label: "Commandes",
    src: "https://scanandstock-media.s3.eu-west-3.amazonaws.com/videos/Video_site_2_order.mp4",
  },
  {
    key: "comparateur",
    label: "Comparateur",
    src: "https://scanandstock-media.s3.eu-west-3.amazonaws.com/videos/Video_site_3_coompy.mp4",
  },
  {
    key: "alertes",
    label: "Alertes",
    src: "https://scanandstock-media.s3.eu-west-3.amazonaws.com/videos/Video_site_4_stockout.mp4",
  },
  {
    key: "stats",
    label: "Statistiques",
    src: "https://scanandstock-media.s3.eu-west-3.amazonaws.com/videos/Video_site_5_statistics.mp4",
  },
];
---

<section class="features-tabs">
  <div class="tabs-bar" role="tablist">
    {
      videos.map((v, i) => (
        <button
          type="button"
          class:list={["tab", { active: i === 0 }]}
          data-index={i}
          data-id={v.label}
          data-src={v.src}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
        >
          {v.label}
        </button>
      ))
    }
  </div>

  <div class="video-box">
    <div class="video-frame">
      <div id="features-player">
        {
          videos.map((v, i) => (
            <video
              class:list={["video-item", { active: i === 0 }]}
              data-index={i}
              data-src={v.src}
              width="100%"
              playsinline
              preload="none"
              muted
            ></video>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .features-tabs {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 90%;
    margin: 0 auto;
    margin-bottom: 2rem;
  }

  /* ─── Pilule blanche d'onglets ─────────────────────────── */
  .tabs-bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    padding: 10px;
    background: #ffffff;
    border-radius: 999px;
    overflow-x: auto;
    scrollbar-width: none;
    margin: 15px 0; /* chevauchement avec la box vidéo */
  }
  .tabs-bar::-webkit-scrollbar {
    display: none;
  }
  .tab {
    flex: 0 0 auto;
    border: 1.5px solid #5bafab;
    background: transparent;
    color: #5bafab;
    padding: 6px 18px;
    border-radius: 999px;
    cursor: pointer;
    font-weight: 600;
    white-space: nowrap;
    transition: all 150ms ease;
  }
  .tab.active {
    background: #12a19a;
  }
  .tab.active :global(*),
  .tab.active {
    color: #ffffff;
    font-weight: 700;
  }

  /* ─── Encadré contenant la vidéo ───────────────────────── */
  .video-box {
    position: relative;
    z-index: 1;
    width: 100%;
    border-radius: 24px;
    background: transparent;
  }

  .video-frame {
    position: relative;
    width: 100%;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .video-frame :global(.video-item) {
    display: none;
    width: 100%;
    height: 100%;
    background: transparent;
    object-fit: fill;
    border-radius: 20px;
  }
  .video-frame :global(.video-item.active) {
    display: block;
  }

  /* ─── Tablette / desktop ───────────────────────────────── */
  @media screen and (min-width: 1024px) {
    .tabs-bar {
      gap: 14px;
      padding: 12px 20px;
      margin-bottom: -32px;
    }
    .tab {
      padding: 8px 24px;
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab {
      transition: none;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(
    ".features-tabs .tab",
  );
  const videoEls = document.querySelectorAll<HTMLVideoElement>(
    ".features-tabs .video-item",
  );

  // Lazy loading : les vidéos n'ont pas de src au chargement (data-src).
  // On ne télécharge une vidéo qu'au moment où elle doit être lue.
  function loadVideo(video: HTMLVideoElement) {
    if (!video.src && video.dataset.src) {
      video.src = video.dataset.src;
    }
  }

  function activateTab(index: number) {
    tabs.forEach((t) => {
      t.classList.remove("active");
      t.setAttribute("aria-selected", "false");
    });
    tabs[index].classList.add("active");
    tabs[index].setAttribute("aria-selected", "true");

    videoEls.forEach((v, i) => {
      if (i === index) {
        v.classList.add("active");
        loadVideo(v);
        v.play().catch(() => {});
      } else {
        v.classList.remove("active");
        v.pause();
      }
    });
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => activateTab(i));
  });

  videoEls.forEach((v, i) => {
    v.addEventListener("ended", () => {
      activateTab((i + 1) % videoEls.length);
    });
  });

  // La 1re vidéo n'est chargée et lancée que lorsque la section
  // devient visible (même pattern que VideoPresentation).
  const section = document.querySelector(".features-tabs");
  const firstVideo = videoEls[0];
  if (section && firstVideo) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadVideo(firstVideo);
            firstVideo.play().catch(() => {});
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 },
    );
    observer.observe(section);
  }
</script>
