---
const videos = [
  {
    key: "stock",
    label: "Stock",
    src: "https://scanandstock-media.s3.eu-west-3.amazonaws.com/videos/Video_site_1_stock.mp4",
  },
  {
    key: "commandes",
    label: "Commandes",
    src: "https://scanandstock-media.s3.eu-west-3.amazonaws.com/videos/Video_site_2_order.mp4",
  },
  {
    key: "comparateur",
    label: "Comparateur",
    src: "https://scanandstock-media.s3.eu-west-3.amazonaws.com/videos/Video_site_3_coompy.mp4",
  },
  {
    key: "alertes",
    label: "Alertes",
    src: "https://scanandstock-media.s3.eu-west-3.amazonaws.com/videos/Video_site_4_stockout.mp4",
  },
  {
    key: "stats",
    label: "Statistiques",
    src: "https://scanandstock-media.s3.eu-west-3.amazonaws.com/videos/Video_site_5_statistics.mp4",
  },
];
---

<section class="features-tabs">
  <div
    class="tabs-bar"
    role="tablist"
    aria-label="Fonctionnalités de Scan & Stock"
  >
    {
      videos.map((v, i) => (
        <button
          type="button"
          class:list={["tab", { active: i === 0 }]}
          data-index={i}
          id={`tab-${v.key}`}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`panel-${v.key}`}
          tabindex={i === 0 ? 0 : -1}
        >
          {v.label}
        </button>
      ))
    }
  </div>

  <div class="video-box">
    <div class="video-frame">
      <div id="features-player">
        {
          videos.map((v, i) => (
            <video
              class:list={["video-item", { active: i === 0 }]}
              data-index={i}
              data-src={v.src}
              id={`panel-${v.key}`}
              role="tabpanel"
              aria-label={v.label}
              aria-labelledby={`tab-${v.key}`}
              tabindex={0}
              width="100%"
              playsinline
              preload="none"
              muted
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .features-tabs {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 90%;
    margin: 0 auto;
    margin-bottom: 2rem;
  }

  /* ─── Pilule blanche d'onglets ─────────────────────────── */
  .tabs-bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    padding: 10px;
    background: #ffffff;
    border-radius: 999px;
    overflow-x: auto;
    scrollbar-width: none;
    margin: 15px 0; /* chevauchement avec la box vidéo */
  }
  .tabs-bar::-webkit-scrollbar {
    display: none;
  }
  .tab {
    flex: 0 0 auto;
    border: 1.5px solid #5bafab;
    background: transparent;
    color: #5bafab;
    padding: 6px 18px;
    border-radius: 999px;
    cursor: pointer;
    font-weight: 600;
    white-space: nowrap;
    transition: all 150ms ease;
    line-height: 1.5;
  }
  .tab.active {
    background: var(--color-primary);
  }
  .tab.active :global(*),
  .tab.active {
    color: #ffffff;
    font-weight: 700;
  }

  /* ─── Encadré contenant la vidéo ───────────────────────── */
  .video-box {
    position: relative;
    z-index: 1;
    width: 100%;
    border-radius: 24px;
    background: transparent;
  }

  .video-frame {
    position: relative;
    width: 100%;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 20px;
    /* Fond de marque visible avant chargement (état au repos sur tactile, où
       la 1re vidéo n'autoplay pas — voir garde tactile dans le <script>).
       La vidéo (object-fit: fill) le recouvre entièrement une fois lue. */
  }
  #features-player {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .video-frame :global(.video-item) {
    position: absolute;
    inset: 0;
    width: 100%;
    background: transparent;
    object-fit: fill;
    border-radius: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }
  .video-frame :global(.video-item.active) {
    opacity: 1;
    pointer-events: auto;
  }

  /* ─── Tablette / desktop ───────────────────────────────── */
  @media screen and (min-width: 1024px) {
    .tabs-bar {
      gap: 14px;
      padding: 12px 20px;
      margin-bottom: -32px;
    }
    .tab {
      padding: 8px 24px;
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab {
      transition: none;
    }
    .video-frame :global(.video-item) {
      transition: none;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(
    ".features-tabs .tab",
  );
  const videoEls = document.querySelectorAll<HTMLVideoElement>(
    ".features-tabs .video-item",
  );

  // Lazy loading : les vidéos n'ont pas de src au chargement (data-src).
  // On ne télécharge une vidéo qu'au moment où elle doit être lue.
  function loadVideo(video: HTMLVideoElement) {
    if (!video.src && video.dataset.src) {
      video.src = video.dataset.src;
    }
  }

  function activateTab(index: number, { focus = false } = {}) {
    tabs.forEach((t) => {
      t.classList.remove("active");
      t.setAttribute("aria-selected", "false");
      // Roving tabindex : seul l'onglet actif est tabulable.
      t.setAttribute("tabindex", "-1");
    });
    tabs[index].classList.add("active");
    tabs[index].setAttribute("aria-selected", "true");
    tabs[index].setAttribute("tabindex", "0");
    // Déplace le focus seulement lors d'une navigation clavier explicite
    // (pas pendant l'auto-avance, qui ne doit pas voler le focus).
    if (focus) tabs[index].focus();
    const bar = tabs[index].closest<HTMLElement>(".tabs-bar");
    if (bar) {
      const tab = tabs[index];
      const tabCenter = tab.offsetLeft + tab.offsetWidth / 2;
      bar.scrollTo({
        left: tabCenter - bar.offsetWidth / 2,
        behavior: "smooth",
      });
    }

    videoEls.forEach((v, i) => {
      if (i === index) {
        v.classList.add("active");
        loadVideo(v);
        v.play().catch(() => {});
      } else {
        v.classList.remove("active");
        v.pause();
      }
    });
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => activateTab(i));

    // Navigation clavier du pattern ARIA tabs (activation automatique).
    tab.addEventListener("keydown", (e) => {
      const last = tabs.length - 1;
      let next: number | null = null;
      if (e.key === "ArrowRight") next = i === last ? 0 : i + 1;
      else if (e.key === "ArrowLeft") next = i === 0 ? last : i - 1;
      else if (e.key === "Home") next = 0;
      else if (e.key === "End") next = last;
      if (next !== null) {
        e.preventDefault();
        activateTab(next, { focus: true });
      }
    });
  });

  videoEls.forEach((v, i) => {
    v.addEventListener("ended", () => {
      activateTab((i + 1) % videoEls.length);
    });
  });

  // Garde tactile : sur mobile/tablette on n'autoplay pas. La 1re vidéo n'est
  // lancée qu'au tap d'un onglet (geste utilisateur, autorisé par iOS). Évite
  // de décoder une vidéo non sollicitée au scroll (jank). Cohérent avec le garde
  // des vidéos témoignages et de VideoPresentation.
  const isTouch = window.matchMedia("(hover: none), (pointer: coarse)").matches;

  // Desktop : la 1re vidéo est chargée et lancée quand la section devient
  // visible (même pattern que VideoPresentation).
  const section = document.querySelector(".features-tabs");
  const firstVideo = videoEls[0];
  if (!isTouch && section && firstVideo) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadVideo(firstVideo);
            firstVideo.play().catch(() => {});
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 },
    );
    observer.observe(section);
  }
</script>
