---
import { Image } from "astro:assets";
import Computer from "../assets/images/computer.png";
import Scanner from "../assets/images/scanner.png";
import Phone from "../assets/images/phone.png";
import ReserveButton from "./ReserveButton.astro";
---

<section class="container">
  <div class="text">
    <p class="paragraphe">
      Fini les tableaux de bords complexes et non à jour, gérez vos mouvements
      de stocks et vos commandes de la façon la plus intuitive qu’il soit avec
      <strong>Scan & Stock</strong> !
    </p>
    <p class="paragraphe">
      En tant que chirurgien-dentiste, assistantes dentaires ou encore
      prothésistes dentaires, nos besoins évoluent constamment. C’est la raison
      pour laquelle <strong
        >Scan & Stock s’engage à réaliser régulièrement des mises à jour</strong
      > afin d’intégrer les nouvelles fonctionnalités que vous nous proposez et dont
      vous avez besoin.
    </p>
    <p class="paragraphe">
      Tout doit aller vite dans nos cabinets, <strong
        >Scan & Stock se veut un logiciel facile et rapide</strong
      > à prendre en main afin de limiter la charge mentale des membres de l’équipe.
    </p>
  </div>

  <div class="separator"></div>
  <div class="img-section">
    <Image
      class="img scanner"
      src={Scanner}
      alt="image d'une douchette"
      width={300}
    />
    <Image
      class="img computer"
      src={Computer}
      alt="image d'ordinateur"
      width={400}
    />
    <Image class="img phone" src={Phone} alt="image de téléphone" width={70} />
  </div>
</section>
<ReserveButton class="dark" />

<style>
  /* ─── Mobile ─────────────────────────────────────────── */
  .container {
    display: flex;
    flex-direction: column-reverse;
  }
  .img-section {
    width: 100%;
    height: 20rem;
    margin: 2rem auto;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }
  .text {
    flex: 1;
  }
  .separator {
    display: none;
  }
  .paragraphe {
    font-weight: 500;
    margin: 1rem auto;
    color: #27333a;
    font-size: 16px;
    letter-spacing: 0.5px;
  }
  .img {
    position: absolute;
  }
  .scanner {
    z-index: 1;
    translate: -120px -10px;
  }
  .computer {
    z-index: 2;
  }
  .phone {
    z-index: 2;
    translate: 140px 40px;
    transform: rotate(-3deg);
  }

  /* ─── Tablet ─────────────────────────────────────────── */
  @media screen and (min-width: 768px) {
    .container {
      max-width: unset;
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 0 3rem;
    }
    .separator {
      display: flex;
      width: 1px;
      height: 600px;
      border-left: 2px dashed #545d638c;
      margin: 0 40px;
    }
    .paragraphe {
      flex: 1;
    }
    .img-section {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      flex: 1;
    }
  }
</style>
