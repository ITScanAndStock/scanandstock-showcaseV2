---
import { Image } from "astro:assets";
import Computer from "../assets/images/computer.png";
import Scanner from "../assets/images/scanner.png";
import Phone from "../assets/images/phone.png";
import ReserveButton from "./ReserveButton.astro";
---

<section class="container">
  <div class="text">
    <p class="paragraphe">
      Fini les tableaux de bords complexes et non à jour, gérez vos mouvements
      de stocks et vos commandes de la façon la plus intuitive qu’il soit avec
      <strong>Scan & Stock</strong> !
    </p>
    <p class="paragraphe">
      En tant que chirurgien-dentiste, assistantes dentaires ou encore
      prothésistes dentaires, nos besoins évoluent constamment. C’est la raison
      pour laquelle <strong
        >Scan & Stock s’engage à réaliser régulièrement des mises à jour</strong
      > afin d’intégrer les nouvelles fonctionnalités que vous nous proposez et dont
      vous avez besoin.
    </p>
    <p class="paragraphe">
      Tout doit aller vite dans nos cabinets, <strong
        >Scan & Stock se veut un logiciel facile et rapide</strong
      > à prendre en main afin de limiter la charge mentale des membres de l’équipe.
    </p>
  </div>

  <div class="separator"></div>
  <div class="img-section">
    <!-- Formes décoratives derrière les images : elles s'écartent au scroll (teal monte, bleu descend) -->
    <div class="deco deco-teal" aria-hidden="true" data-parallax-speed="-0.06"></div>
    <div class="deco deco-blue" aria-hidden="true" data-parallax-speed="0.09"></div>

    <Image
      class="img scanner"
      src={Scanner}
      alt="image d'une douchette"
      width={300}
      data-parallax-speed="-0.08"
    />
    <Image
      class="img computer"
      src={Computer}
      alt="image d'ordinateur"
      width={400}
      data-parallax-speed="0.04"
    />
    <Image class="img phone" src={Phone} alt="image de téléphone" width={70} data-parallax-speed="0.08"/>
  </div>
</section>
<ReserveButton class="dark" />

<style>
  /* ─── Mobile ─────────────────────────────────────────── */
  .container {
    display: flex;
    flex-direction: column-reverse;
  }
  /* La hauteur de la zone est donnée par l'ordinateur (seule image dans le flux) :
     plus de hauteur figée ni d'overflow hidden qui clippait les formes. */
  .img-section {
    width: 100%;
    margin: 2rem auto;
    padding: 2.5rem 0 3.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  /* ─── Formes décoratives ─────────────────────────────── */
  .deco {
    position: absolute;
    border-radius: 14px;
    filter: blur(2px);
    pointer-events: none;
    z-index: 0;
    will-change: transform;
  }

  /* teal : rotate(17.6deg), ombre — dépasse derrière le haut-droit de l'ordinateur.
     Tailles en % de la zone (aspect-ratio fixe) : elles suivent l'échelle des images. */
  .deco-teal {
    width: clamp(130px, 34%, 260px);
    aspect-ratio: 3 / 4;
    background: linear-gradient(
      122deg,
      rgba(18, 161, 154, 0.5) 9.7%,
      rgba(18, 161, 154, 0.25) 104%
    );
    box-shadow: 0 4px 4px rgba(0, 0, 0, 0.25);
    top: 0;
    left: 44%;
    /* translateY d'abord : le déplacement parallaxe reste vertical malgré la rotation */
    transform: translateY(var(--parallax-y, 0px)) rotate(17.6deg);
  }

  /* bleu : rotate(35.4deg) — côté droit, derrière le téléphone */
  .deco-blue {
    width: clamp(100px, 26%, 200px);
    aspect-ratio: 3 / 4;
    background: linear-gradient(
      116deg,
      rgba(2, 73, 101, 0.5) 9.7%,
      rgba(65, 119, 140, 0.5) 104%
    );
    top: 10%;
    right: 6%;
    transform: translateY(var(--parallax-y, 0px)) rotate(35.4deg);
  }
  .text {
    flex: 1;
  }
  .separator {
    display: none;
  }
  .paragraphe {
    font-weight: 500;
    margin: 1rem auto;
    color: #27333a;
    font-size: 16px;
    letter-spacing: 0.5px;
  }
  .img {
    height: auto;
  }
  /* L'ordinateur reste dans le flux : c'est lui qui donne sa hauteur à la zone. */
  .computer {
    position: relative;
    z-index: 2;
    width: clamp(280px, 78%, 480px);
    will-change: transform;
    transform: translateY(var(--parallax-y, 0px));
  }
  /* Douchette et téléphone se calent sur le centre (translate en % de leur propre
     taille : les décalages suivent l'échelle au lieu d'être figés en px). */
  .scanner {
    position: absolute;
    z-index: 1;
    width: clamp(190px, 55%, 320px);
    translate: -42% -4%;
    will-change: transform;
    transform: translateY(var(--parallax-y, 0px));
  }
  .phone {
    position: absolute;
    z-index: 3;
    width: clamp(58px, 16%, 90px);
    translate: 190% 18%;
    will-change: transform;
    transform: translateY(var(--parallax-y, 0px)) rotate(-3deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .deco,
    .scanner,
    .computer,
    .phone {
      will-change: auto;
    }
  }

  /* ─── Tablet ─────────────────────────────────────────── */
  @media screen and (min-width: 768px) {
    .container {
      max-width: unset;
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 0 3rem;
    }
    .separator {
      display: flex;
      width: 1px;
      height: 600px;
      border-left: 2px dashed #545d638c;
      margin: 0 40px;
    }
    .paragraphe {
      flex: 1;
    }
    .img-section {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      flex: 1;
    }
  }
</style>
