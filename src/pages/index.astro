---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import MainBox from "../components/ui/Main-box.astro";
import HeroBox from "../components/ui/Hero-box.astro";
import Stats from "../assets/stats.svg";
import Order from "../assets/order.svg";
import Stock from "../assets/stock.svg";
import Compare from "../assets/compare.svg";
import Warning from "../assets/warning.svg";
import GradientTitle from "../components/ui/GradientTitle.astro";
import Laulan from "../assets/photos/Camille_LAULAN.jpg";
import Dischant from "../assets/photos/Claire_DISCHANT.png";
import Raux from "../assets/photos/Frederic_RAUX.png";
import Toth from "../assets/photos/Kevin_TOTH.png";
import Camaleonte from "../assets/photos/Gregory_CAMALEONTE.jpg";
import Colin from "../assets/photos/Matthieu_COLIN.png";
import Keller from "../assets/photos/Pierre_kELLER.png";
---

<BaseLayout title="Scan&Stock | Accueil">
  <MainBox>
    <HeroBox>
      <h1 class="title">
        Le logiciel N°1 pour cabinets dentaires 100% en ligne
      </h1>
      <p class="subtitle">
        Optimisez votre temps et votre budget avec le logiciel Scan&Stock !
      </p>

      <div class="parallax-container">
        <Image class="stats" src={Stats} alt="statistique" />
        <Image class="order" src={Order} alt="commande" />
        <Image class="stock" src={Stock} alt="stock" />
        <Image class="warning" src={Warning} alt="stock" />
        <Image class="compare" src={Compare} alt="stock" />
      </div>

      <button
        class="booking"
        onclick="Calendly.initPopupWidget({url: 'https://calendly.com/arthurscanandstock'})"
        >Réservé une démo</button
      >
    </HeroBox>
    <section class="clients">
      <GradientTitle>Ils utilisent Scan&amp;Stock</GradientTitle>
      <div class="carousel">
        <div class="group">
          <Image
            draggable="false"
            class="card"
            src={Laulan}
            alt="docteur laulan"
          />
          <Image
            draggable="false"
            class="card"
            src={Dischant}
            alt="docteur laulan"
          />
          <Image
            draggable="false"
            class="card"
            src={Raux}
            alt="docteur laulan"
          />
          <Image
            draggable="false"
            class="card card--lower"
            src={Toth}
            alt="docteur laulan"
          />
          <Image
            draggable="false"
            class="card"
            src={Camaleonte}
            alt="docteur laulan"
          />
          <Image
            draggable="false"
            class="card card--lower"
            src={Colin}
            alt="docteur laulan"
          />
          <Image
            draggable="false"
            class="card"
            src={Keller}
            alt="docteur laulan"
          />
        </div>
        <div aria-hidden="true" class="group">
          <Image
            draggable="false"
            class="card"
            src={Laulan}
            alt="docteur laulan"
          />
          <Image
            draggable="false"
            class="card"
            src={Dischant}
            alt="docteur laulan"
          />
          <Image
            draggable="false"
            class="card"
            src={Raux}
            alt="docteur laulan"
          />
          <Image
            draggable="false"
            class="card card--lower"
            src={Toth}
            alt="docteur laulan"
          />
          <Image
            draggable="false"
            class="card"
            src={Camaleonte}
            alt="docteur laulan"
          />
          <Image
            draggable="false"
            class="card card--lower"
            src={Colin}
            alt="docteur laulan"
          />
          <Image
            draggable="false"
            class="card"
            src={Keller}
            alt="docteur laulan"
          />
        </div>
      </div>
    </section>
  </MainBox>
</BaseLayout>

<style>
  /* ─── Mobile ───────────────────────────────────────────  */
  .title {
    color: white;
    font-size: clamp(20px, 3vw, 40px);
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .subtitle {
    color: white;
    text-align: center;
    font-weight: 400;
    font-size: clamp(12px, 1.5vw, 20px);
  }
  .parallax-container {
    width: 100%;
    position: relative;
    padding: 40px 0;
  }
  .stats {
    padding-top: 20px;
    height: fit-content;
    width: fit-content;
    margin: auto;
  }
  .order {
    position: absolute;
    top: 30px;
    width: clamp(90px, 32%, 220px);
    height: fit-content;
    box-shadow: 4px 4px 37.5px 0px #00000040;
  }
  .stock {
    position: absolute;
    top: 20px;
    right: 0;
    width: clamp(200px, 64%, 410px);
    height: fit-content;
    box-shadow: 4px 4px 37.5px 0px #00000040;
  }
  .warning {
    position: absolute;
    bottom: 20px;
    width: clamp(170px, 55%, 250px);
    height: fit-content;
    box-shadow: 4px 4px 37.5px 0px #00000040;
  }
  .compare {
    position: absolute;
    bottom: 0;
    width: clamp(100px, 30%, 180px);
    right: 30px;
    height: fit-content;
    box-shadow: 4px 4px 37.5px 0px #00000040;
  }
  .order,
  .stock,
  .warning,
  .compare {
    will-change: transform;
  }
  .booking {
    margin: 20px 0;
    padding: 5px 20px;
    border-radius: 20px;
    color: #496f7f;
    font-weight: 700;
    font-size: 20px;
    background-color: #fff;
    transition: all 80ms ease;
  }
  .booking:active {
    transform: scale(0.9);
  }
  .clients {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 0;
    gap: 10px;
  }
  .carousel {
    margin: 4rem 0;
    display: flex;
    overflow-x: auto;
    flex: 1;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 15%,
      black 85%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 15%,
      black 85%,
      transparent
    );
  }
  .carousel::-webkit-scrollbar {
    display: none;
  }
  .group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1em;
    padding-right: 1em;
    animation: spin 20s infinite linear;
  }
  .card {
    flex: 0 0 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
  }
  .card--lower {
    object-position: center 10% !important;
  }
  /* ─── TABLET ───────────────────────────────────────────  */
  @media screen and (min-width: 768px) {
    .booking {
      margin: 30px 0;
      border-radius: 25px;
      font-size: 24px;
    }
    .clients {
      flex-direction: row;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .order,
    .stock,
    .warning,
    .compare {
      will-change: auto;
    }
  }

  /* ─── desktop ───────────────────────────────────────────  */
  @media screen and (min-width: 1240px) {
    .parallax-container {
      padding: 0;
    }
    .order {
      top: unset;
      right: 13%;
      bottom: 0;
    }
    .stock {
      top: unset;
      left: 0;
      bottom: 20%;
    }
    .warning {
      bottom: unset;
      right: 5%;
      top: 16%;
    }
    .compare {
      left: 10%;
      top: 15%;
    }
  }
  @keyframes spin {
    from {
      translate: 0;
    }
    to {
      translate: -100%;
    }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reduced) {
    const items: { el: HTMLElement; speed: number }[] = [
      { el: document.querySelector<HTMLElement>(".order")!, speed: 0.18 },
      { el: document.querySelector<HTMLElement>(".stock")!, speed: -0.14 },
      { el: document.querySelector<HTMLElement>(".warning")!, speed: 0.24 },
      { el: document.querySelector<HTMLElement>(".compare")!, speed: -0.1 },
    ];

    let ticking = false;

    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const y = window.scrollY;
          items.forEach(({ el, speed }) => {
            el.style.transform = `translateY(${y * speed}px)`;
          });
          ticking = false;
        });
        ticking = true;
      }
    });
  }
</script>
