---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import MainBox from "../components/ui/Main-box.astro";
import HeroBox from "../components/ui/Hero-box.astro";
import Stats from "../assets/stats.svg";
import Order from "../assets/order.svg";
import Stock from "../assets/stock.svg";
import Compare from "../assets/compare.svg";
import Warning from "../assets/warning.svg";
import ClientsCarousel from "../components/ClientsCarousel.astro";
import GradientTitle from "../components/ui/GradientTitle.astro";
---

<BaseLayout title="Scan&Stock | Accueil">
  <MainBox>
    <HeroBox>
      <h1 class="title">
        Le logiciel N°1 pour cabinets dentaires 100% en ligne
      </h1>
      <p class="subtitle">
        Optimisez votre temps et votre budget avec le logiciel Scan&Stock !
      </p>

      <div class="parallax-container">
        <Image class="stats" src={Stats} alt="statistique" />
        <Image class="order" src={Order} alt="commande" />
        <Image class="stock" src={Stock} alt="stock" />
        <Image class="warning" src={Warning} alt="stock" />
        <Image class="compare" src={Compare} alt="stock" />
      </div>

      <button
        class="booking"
        onclick="Calendly.initPopupWidget({url: 'https://calendly.com/arthurscanandstock'})"
        >Réservé une démo</button
      >
    </HeroBox>
    <ClientsCarousel />
    <section class="video-section">
      <div class="video-wrapper">
        <iframe
          src="https://www.youtube.com/embed/x3FlUQBuKHY"
          title="Présentation Scan&Stock"
          allowfullscreen></iframe>
      </div>

      <div class="separator"></div>
      <div class="texts">
        <p class="paragraphe">
          Au sein d’un cabinet dentaire, le poste achat doit représenter <strong
          >
            5 à 7 % du chiffre d’affaires</strong
          >, cependant peu de praticiens savent exactement combien représente
          l’achat de consommables dans leurs structures.
        </p>
        <p class="paragraphe">
          En utilisant un <strong>système de gestion efficace</strong> leur permettant
          de connaître leurs stocks en <strong> temps réel</strong>, les
          assistantes ou secrétaires peuvent générer leurs commandes au <strong
            >moment idéal et ainsi faire des économies sur le poste achat</strong
          >. <strong>Scan & Stock</strong> est disponible pour les cabinets dentaires,
          laboratoires de prothèses et toutes les professions médicales.
        </p>
      </div>
    </section>

    <GradientTitle as="h3">
      Une gestion des
      <span class="underline"> stocks et des commandes optimale </span>
    </GradientTitle>
  </MainBox>
</BaseLayout>

<style>
  /* ─── Mobile ───────────────────────────────────────────  */
  .title {
    color: white;
    font-size: clamp(20px, 3vw, 40px);
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .subtitle {
    color: white;
    text-align: center;
    font-weight: 400;
    font-size: clamp(12px, 1.5vw, 20px);
  }
  .parallax-container {
    width: 100%;
    position: relative;
    padding: 40px 0;
  }
  .stats {
    padding-top: 20px;
    height: fit-content;
    width: fit-content;
    margin: auto;
  }
  .order {
    position: absolute;
    top: 30px;
    width: clamp(90px, 32%, 220px);
    height: fit-content;
    box-shadow: 4px 4px 37.5px 0px #00000040;
  }
  .stock {
    position: absolute;
    top: 20px;
    right: 0;
    width: clamp(200px, 64%, 410px);
    height: fit-content;
    box-shadow: 4px 4px 37.5px 0px #00000040;
  }
  .warning {
    position: absolute;
    bottom: 20px;
    width: clamp(170px, 55%, 250px);
    height: fit-content;
    box-shadow: 4px 4px 37.5px 0px #00000040;
  }
  .compare {
    position: absolute;
    bottom: 0;
    width: clamp(100px, 30%, 180px);
    right: 30px;
    height: fit-content;
    box-shadow: 4px 4px 37.5px 0px #00000040;
  }
  .order,
  .stock,
  .warning,
  .compare {
    will-change: transform;
  }
  .booking {
    margin: 20px 0;
    padding: 5px 20px;
    border-radius: 20px;
    color: #496f7f;
    font-weight: 700;
    font-size: 20px;
    background-color: #fff;
    transition: all 80ms ease;
  }
  .booking:active {
    transform: scale(0.9);
  }
  .video-section {
    width: 100%;
    max-width: 900px;
    margin: 2rem auto;
  }
  .separator {
    display: none;
  }
  .video-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .video-wrapper iframe {
    width: 100%;
    height: 100%;
    border-radius: 20px;
    border: unset;
  }
  .paragraphe {
    line-height: 30px;
    font-weight: 500;
    margin: 1rem auto;
    color: #27333a;
    font-size: 16px;
    letter-spacing: 0.5px;
  }
  /* ─── TABLET ───────────────────────────────────────────  */
  @media screen and (min-width: 768px) {
    .booking {
      margin: 30px 0;
      border-radius: 25px;
      font-size: 24px;
    }

    .video-section {
      max-width: unset;
      display: flex;
      align-items: center;
      padding: 0 3rem;
    }
    .video-wrapper {
      flex: 0.7;
    }
    .separator {
      display: flex;
      width: 1px;
      height: 320px; /* ou ce que tu veux */
      border-left: 2px dashed #545d638c;
      margin: 0 40px;
    }
    .texts {
      flex: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .order,
    .stock,
    .warning,
    .compare {
      will-change: auto;
    }
  }

  /* ─── desktop ───────────────────────────────────────────  */
  @media screen and (min-width: 1240px) {
    .parallax-container {
      padding: 0;
    }
    .order {
      top: unset;
      right: 13%;
      bottom: 0;
    }
    .stock {
      top: unset;
      left: 0;
      bottom: 20%;
    }
    .warning {
      bottom: unset;
      right: 5%;
      top: 16%;
    }
    .compare {
      left: 10%;
      top: 15%;
    }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reduced) {
    const items: { el: HTMLElement; speed: number }[] = [
      { el: document.querySelector<HTMLElement>(".order")!, speed: 0.18 },
      { el: document.querySelector<HTMLElement>(".stock")!, speed: -0.14 },
      { el: document.querySelector<HTMLElement>(".warning")!, speed: 0.24 },
      { el: document.querySelector<HTMLElement>(".compare")!, speed: -0.1 },
    ];

    let ticking = false;

    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const y = window.scrollY;
          items.forEach(({ el, speed }) => {
            el.style.transform = `translateY(${y * speed}px)`;
          });
          ticking = false;
        });
        ticking = true;
      }
    });
  }
</script>
