---
import {Image} from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import MainBox from "../components/ui/Main-box.astro";
import HeroBox from "../components/ui/Hero-box.astro";
import Stats from "../assets/stats.svg";
import Order from "../assets/order.svg";
import Stock from "../assets/stock.svg";
import Compare from "../assets/compare.svg";
import Warning from "../assets/warning.svg";
import ClientsCarousel from "../components/ClientsCarousel.astro";
import GradientTitle from "../components/ui/GradientTitle.astro";
import FeaturesTabs from "../components/FeaturesTabs.astro";
import VideoPresentation from "../components/VideoPresentation.astro";
import InfoFeatures from "../components/InfoFeatures.astro";
import ReserveButton from "../components/ReserveButton.astro";
import InfoUsers from "../components/InfoUsers.astro";
import ImgPresentation from "../components/ImgPresentation.astro";
import CardCarousel from "../components/CardCarousel.astro";
import Carousel from "../components/Carousel.astro";
import StockPlace from "../assets/photos/carousel/stock_place.png";
import Scanner from "../assets/photos/carousel/scanner.png";
import LessStock from "../assets/photos/carousel/less_stock.png";
import ImageCarousel from "../components/ImageCarousel.astro";
import MyCoompy from "../assets/photos/carousel/mycoompy.png";
import MyscanScan from "../assets/photos/carousel/myscanandstock_scan.png";
import MyscanStock from "../assets/photos/carousel/myscanandstock_stock.png";
import ScannerApp from "../assets/photos/carousel/scanner_et_app.png";
import TestimonialCharlotte from "../assets/video/testimonial_charlotte.mp4";
import TestimonialJeanChristophe from "../assets/video/testimonial_jean-Christophe.mp4";
import TestimonialKevin from "../assets/video/testimonial_Kevin.mp4";
import PosterCharlotte from "../assets/video/poster/charlotte.png";
import PosterJeanChristophe from "../assets/video/poster/jean-christophe.png";
import PosterKevin from "../assets/video/poster/kevin.png";
import ContactForm from "../components/ContactForm.astro";

const testimonials = [
    {
        src: TestimonialJeanChristophe,
        poster: PosterJeanChristophe.src,
        label: "Témoignage vidéo de Jean-Christophe, utilisateur de Scan & Stock",
        name: "Jean-Christophe Gilbert",
        role: "Chirurgien-dentiste",
    },
    {
        src: TestimonialCharlotte,
        poster: PosterCharlotte.src,
        label: "Témoignage vidéo de Charlotte, utilisatrice de Scan & Stock",
        name: "Charlotte Farges",
        role: "Chirurgien-dentiste",
    },
    {
        src: TestimonialKevin,
        poster: PosterKevin.src,
        label: "Témoignage vidéo de Kevin, utilisateur de Scan & Stock",
        name: "Cabinet dentaire république",
        role: "Villeneuve-d'Ascq",
    },
];

const carouselCards = [
    {
        src: StockPlace,
        alt: "Espace de stockage dentaire organisé avec les produits Scan&Stock",
        title: "Economisez jusqu’à 20 % sur le poste achat",
        text: "Que ce soit dans des cabinets d’omnipratique ou de spécialités les utilisateurs de Scan & Stock ont économisé de 16 à 20 % sur leur poste achat l’année où ils l’ont mis en place. Dans les cabinets composés d’une équipe plus importante les économies liées à la mise en place de Scan & Stock sont souvent plus importantes.",
    },
    {
        src: Scanner,
        alt: "Espace de stockage dentaire organisé avec les produits Scan&Stock",
        title: "Diminuez le temps non clinique de vos assistants dentaires",
        text: "Nos assistantes dentaires sont rentables à nos côtés, en salle de soins, pas en salle de stérilisation à gérer les commandes ou à éplucher les catalogues de vépécistes pour retrouver les références d’un produit utilisé il y a 6 mois. Les chirurgiens-dentistes utilisateurs de Scan&Stock ont remarqué qu’en moyenne le temps passé par leurs équipes à gérer les stocks et les commandes est passé de plus d’1h15 par semaine à moins de 20 minutes.",
    },
    {
        src: LessStock,
        alt: "Espace de stockage dentaire organisé avec les produits Scan&Stock",
        title: "Limitez l’empreinte écologique de votre cabinet dentaire",
        text: "Le surstockage et les périmés sont les fléaux de nombreux cabinets dentaires. La peur de manquer ou encore les offres attrayantes de fabricants et fournisseurs entraînent trop souvent des commandes inutiles. Ces commandes (et donc cet argent qui dort !) se retrouvent sur nos étagères ou au fin fond de tiroir parfois jusqu’à ce que leurs dates de péremption soient dépassées ! Pensez à la planète et stoppez le surstockage !",
    },
];

const imageCarousel = [
    {src: ScannerApp, alt: "douchette et application Scan&Stock"},
    {src: MyscanScan, alt: "application MyScan&Stock et scanner"},
    {src: MyscanStock, alt: "application MyScan&Stock et gestion de stock"},
    {src: MyCoompy, alt: "application MyCoompy"},
];
---

<BaseLayout
        title="Scan&Stock | Accueil"
        description="Scan&Stock automatise la gestion des stocks et des commandes de votre cabinet dentaire : inventaires par scan, suivi en temps réel, réapprovisionnement simplifié."
>
    <MainBox>
        <HeroBox>
            <h1 class="title">
                Le logiciel N°1 pour cabinets dentaires 100% en ligne
            </h1>
            <p class="subtitle">
                Optimisez votre temps et votre budget avec le logiciel Scan&Stock !
            </p>

            <div class="parallax-container">
                <Image class="stats" src={Stats} alt="statistique"/>
                <Image class="order" src={Order} alt="commande"/>
                <Image class="stock" src={Stock} alt="stock"/>
                <Image class="warning" src={Warning} alt="stock"/>
                <Image class="compare" src={Compare} alt="stock"/>
            </div>

            <ReserveButton/>
        </HeroBox>
        <ClientsCarousel/>
        <VideoPresentation/>

        <GradientTitle as="h3">
            Une gestion des
            <span class="underline"> stocks et des commandes optimale </span>
        </GradientTitle>
        <FeaturesTabs/>
    </MainBox>
    <MainBox class="bottom-up">
        <GradientTitle as="h2">
            Une gestion des
            <span class="underline"> stocks et des commandes optimale </span>
        </GradientTitle>
        <p class="text">
            Scan & Stock est un logiciel dentaire créé par un chirurgien-dentiste pour
            les chirurgiens-dentistes. Notre solution a vu le jour en novembre 2021
            lors du congrès de l’ADF. Aujourd’hui, il compte plus de 1 000
            utilisateurs satisfaits répartis en France, en Belgique, en Suisse, dans
            les DOM-TOM, à Monaco et même au Canada. Scan & Stock est un logiciel
            évolutif, chaque année de nouvelles mises à jour sont faites afin de
            répondre aux demandes de nos utilisateurs.
        </p>

        <InfoFeatures/>
    </MainBox>
    <InfoUsers/>

    <MainBox class="bottom-down">
        <GradientTitle as="h2">
            Une solution <span class="underline"
        >adaptée aux besoins des cabinets dentaires</span
        >
        </GradientTitle>
        <ImgPresentation/>
    </MainBox>
    <MainBox>
        <GradientTitle as="h2">
            Les <span class="underline">promesses</span> de Scan & Stock
        </GradientTitle>
        <p class="text">
            Scan & Stock compte aujourd’hui plus de 1000 utilisateurs répartis sur
            plusieurs pays. Ces utilisateurs heureux sont nos meilleurs ambassadeurs !
            En raison des évolutions constantes de notre logiciel, nous ne pouvons
            vous offrir un logiciel de stock gratuit. Cependant, sûr de notre solution
            et des bienfaits qu’elle va vous apporter, notre abonnement vous donne
            droit à un satisfait ou remboursé d’une période de 2 mois.
        </p>
        <Carousel label="Présentation Scan&Stock" withReserveBtn>
            {
                carouselCards.map((card) => (
                        <li class="carousel-slide">
                            <CardCarousel
                                    src={card.src}
                                    alt={card.alt}
                                    title={card.title}
                                    text={card.text}
                            />
                        </li>
                ))
            }
        </Carousel>
    </MainBox>

    <Carousel label="Nos outils" variant="image">
        {
            imageCarousel.map((image) => (
                    <li class="carousel-slide">
                        <ImageCarousel src={image.src} alt={image.alt}/>
                    </li>
            ))
        }
    </Carousel>

    <MainBox>
        <GradientTitle as="h2"
        >Ils <span class="underline">utilisent Scan & Stock</span></GradientTitle
        >
        <div class="testimonials">
            {
                testimonials.map((testimonial) => (
                        <figure class="testimonial-card">
                            <video
                                    class="testimonial-video"
                                    src={testimonial.src}
                                    poster={testimonial.poster}
                                    preload="none"
                                    loop
                                    playsinline
                                    aria-label={testimonial.label}
                            />
                            <figcaption class="testimonial-caption">
                                <span class="testimonial-name">{testimonial.name}</span>
                                <span class="testimonial-role">{testimonial.role}</span>
                            </figcaption>
                        </figure>
                ))
            }
        </div>
        <GradientTitle> Nous contacter</GradientTitle>
        <ContactForm/>
    </MainBox>
</BaseLayout>

<style>
    /* ─── Mobile ───────────────────────────────────────────  */
    .title {
        color: white;
        font-size: clamp(20px, 3vw, 40px);
        font-weight: 700;
        text-align: center;
        margin-bottom: 0.5rem;
    }

    .subtitle {
        color: white;
        text-align: center;
        font-weight: 400;
        font-size: clamp(12px, 1.5vw, 20px);
    }

    .parallax-container {
        width: 100%;
        position: relative;
        padding: 40px 0;
    }

    .stats {
        padding-top: 20px;
        height: fit-content;
        width: fit-content;
        margin: auto;
    }

    .order {
        position: absolute;
        top: 30px;
        width: clamp(90px, 32%, 220px);
        height: fit-content;
        box-shadow: 4px 4px 37.5px 0px #00000040;
    }

    .stock {
        position: absolute;
        top: 20px;
        right: 0;
        width: clamp(200px, 64%, 410px);
        height: fit-content;
        box-shadow: 4px 4px 37.5px 0px #00000040;
    }

    .warning {
        position: absolute;
        bottom: 20px;
        width: clamp(170px, 55%, 250px);
        height: fit-content;
        box-shadow: 4px 4px 37.5px 0px #00000040;
    }

    .compare {
        position: absolute;
        bottom: 0;
        width: clamp(100px, 30%, 180px);
        right: 30px;
        height: fit-content;
        box-shadow: 4px 4px 37.5px 0px #00000040;
    }

    .order,
    .stock,
    .warning,
    .compare {
        will-change: transform;
    }

    .testimonials {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .testimonial-card {
        position: relative;
        width: 360px;
        margin: 0;
        border-radius: 35px;
        overflow: hidden;
    }

    .testimonial-video {
        display: block;
        width: 100%;
        height: 510px;
        object-fit: cover;
        border-radius: 35px;
        background: #000;
        cursor: pointer;
    }

    .testimonial-caption {
        position: absolute;
        inset: auto 0 0 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 70px 24px 22px;
        color: #fff;
        text-align: start;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    /* Voile flouté en dégradé : net en bas, s'estompe vers le haut. */
    .testimonial-caption::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
                to top,
                rgba(0, 0, 0, 0.55) 0%,
                rgba(0, 0, 0, 0) 100%
        );
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        mask-image: linear-gradient(
                to top,
                black 0%,
                black 35%,
                transparent 100%
        );
        border-radius: 35px;
    }

    .testimonial-card.is-playing .testimonial-caption {
        opacity: 0;
    }

    .testimonial-name,
    .testimonial-role {
        position: relative;
    }

    .testimonial-name {
        font-weight: 700;
        font-size: 18px;
        line-height: 1.2;
    }

    .testimonial-role {
        font-weight: 400;
        font-size: 14px;
        opacity: 0.9;
    }

    /* ─── TABLET ───────────────────────────────────────────  */
    @media screen and (min-width: 768px) {
        .text {
            max-width: 80%;
            text-align: start;
            margin: auto;
            line-height: 45px;
            font-size: 18px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .order,
        .stock,
        .warning,
        .compare {
            will-change: auto;
        }
    }

    /* ─── desktop ───────────────────────────────────────────  */
    @media screen and (min-width: 1240px) {
        .parallax-container {
            padding: 0;
        }

        .order {
            top: unset;
            right: 13%;
            bottom: 0;
        }

        .stock {
            top: unset;
            left: 0;
            bottom: 20%;
        }

        .warning {
            bottom: unset;
            right: 5%;
            top: 16%;
        }

        .compare {
            left: 10%;
            top: 15%;
        }
    }
</style>

<script>
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!reduced) {
        const items: { el: HTMLElement; speed: number }[] = [
            {el: document.querySelector<HTMLElement>(".order")!, speed: 0.18},
            {el: document.querySelector<HTMLElement>(".stock")!, speed: -0.14},
            {el: document.querySelector<HTMLElement>(".warning")!, speed: 0.24},
            {el: document.querySelector<HTMLElement>(".compare")!, speed: -0.1},
        ];

        let ticking = false;

        window.addEventListener("scroll", () => {
            if (!ticking) {
                requestAnimationFrame(() => {
                    const y = window.scrollY;
                    items.forEach(({el, speed}) => {
                        el.style.transform = `translateY(${y * speed}px)`;
                    });
                    ticking = false;
                });
                ticking = true;
            }
        });
    }

    const testimonialVideos = document.querySelectorAll<HTMLVideoElement>(
        ".testimonial-video",
    );

    testimonialVideos.forEach((video) => {
        const card = video.closest(".testimonial-card");

        const play = () => {
            // Masque le nom/profession pendant la lecture.
            card?.classList.add("is-playing");
            video.play().catch(() => {
                // Le navigateur bloque la lecture avec son sans geste : on repli en muet.
                video.muted = true;
                video.play().catch(() => {
                });
            });
        };

        const stop = () => {
            card?.classList.remove("is-playing");
            video.pause();
            // Recharge la vidéo pour réafficher le poster (et non la 1re frame).
            video.load();
        };

        video.addEventListener("mouseenter", play);
        video.addEventListener("mouseleave", stop);

        // Support tactile : pas de hover, on bascule lecture/pause au tap.
        video.addEventListener("click", () => {
            if (video.paused) {
                play();
            } else {
                stop();
            }
        });
    });
</script>