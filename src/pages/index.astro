---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import MainBox from "../components/ui/Main-box.astro";
import HeroBox from "../components/ui/Hero-box.astro";
import Stats from "../assets/stats.svg";
import Order from "../assets/order.svg";
import Stock from "../assets/stock.svg";
import Compare from "../assets/compare.svg";
import Warning from "../assets/warning.svg";
---

<BaseLayout title="Scan&Stock | Accueil">
  <MainBox>
    <HeroBox>
      <h1 class="title">
        Le logiciel N°1 pour cabinets dentaires 100% en ligne
      </h1>
      <p class="subtitle">
        Optimisez votre temps et votre budget avec le logiciel Scan&Stock !
      </p>

      <div class="parallax-container">
        <Image class="stats" src={Stats} alt="statistique" />
        <Image class="order" src={Order} alt="commande" />
        <Image class="stock" src={Stock} alt="stock" />
        <Image class="warning" src={Warning} alt="stock" />
        <Image class="compare" src={Compare} alt="stock" />
      </div>

      <button
        class="booking"
        onclick="Calendly.initPopupWidget({url: 'https://calendly.com/arthurscanandstock'})"
        >Réservé une démo</button
      >
    </HeroBox>
  </MainBox>
</BaseLayout>

<style>
  /* ─── Mobile ───────────────────────────────────────────  */
  .title {
    color: white;
    font-size: clamp(20px, 3vw, 40px);
    font-weight: 700;
    text-align: center;
    margin: 1rem 0;
  }
  .subtitle {
    color: white;
    text-align: center;
    font-weight: 400;
    font-size: clamp(12px, 1.5vw, 20px);
  }
  .parallax-container {
    width: 100%;
    position: relative;
    padding: 40px 0;
  }
  .stats {
    padding-top: 20px;
    height: fit-content;
    width: fit-content;
    margin: auto;
  }
  .order {
    position: absolute;
    top: 30px;
    width: clamp(90px, 32%, 220px);
    height: fit-content;
    box-shadow: 4px 4px 37.5px 0px #00000040;
  }
  .stock {
    position: absolute;
    top: 20px;
    right: 0;
    width: clamp(200px, 64%, 410px);
    height: fit-content;
    box-shadow: 4px 4px 37.5px 0px #00000040;
  }
  .warning {
    position: absolute;
    bottom: 20px;
    width: clamp(170px, 55%, 250px);
    height: fit-content;
    box-shadow: 4px 4px 37.5px 0px #00000040;
  }
  .compare {
    position: absolute;
    bottom: 0;
    width: clamp(100px, 30%, 180px);
    right: 30px;
    height: fit-content;
    box-shadow: 4px 4px 37.5px 0px #00000040;
  }
  .order, .stock, .warning, .compare {
    will-change: transform;
  }
  .booking {
    margin: 20px 0;
    padding: 5px 20px;
    border-radius: 20px;
    color: #496f7f;
    font-weight: 700;
    font-size: 20px;
    background-color: #fff;
    transition: all 80ms ease;
  }
  .booking:active {
    transform: scale(0.9);
  }
  /* ─── TABLET ───────────────────────────────────────────  */
  @media screen and (min-width: 768px) {
    .booking {
      margin: 30px 0;
      border-radius: 25px;
      font-size: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .order, .stock, .warning, .compare {
      will-change: auto;
    }
  }

  /* ─── desktop ───────────────────────────────────────────  */
  @media screen and (min-width: 1240px) {
    .order {
      top: unset;
      right: 18%;
      bottom: 0;
    }
    .stock {
      top: unset;
      left: 6%;
      bottom: 20%;
    }
    .warning {
      bottom: unset;
      right: 10%;
      top: 30%;
    }
    .compare {
      left: 15%;
      top: 25%;
    }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reduced) {
    const items: { el: HTMLElement; speed: number }[] = [
      { el: document.querySelector<HTMLElement>(".order")!,   speed:  0.18 },
      { el: document.querySelector<HTMLElement>(".stock")!,   speed: -0.14 },
      { el: document.querySelector<HTMLElement>(".warning")!, speed:  0.24 },
      { el: document.querySelector<HTMLElement>(".compare")!, speed: -0.10 },
    ];

    let ticking = false;

    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const y = window.scrollY;
          items.forEach(({ el, speed }) => {
            el.style.transform = `translateY(${y * speed}px)`;
          });
          ticking = false;
        });
        ticking = true;
      }
    });
  }
</script>
