---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import MainBox from "../components/ui/Main-box.astro";
import HeroBox from "../components/ui/Hero-box.astro";
import Order from "../assets/order.svg";
import Stock from "../assets/stock.svg";
import Compare from "../assets/compare.svg";
import Warning from "../assets/warning.svg";
import ClientsCarousel from "../components/ClientsCarousel.astro";
import GradientTitle from "../components/ui/GradientTitle.astro";
import FeaturesTabs from "../components/FeaturesTabs.astro";
import VideoPresentation from "../components/VideoPresentation.astro";
import InfoFeatures from "../components/InfoFeatures.astro";
import ReserveButton from "../components/ReserveButton.astro";
import InfoUsers from "../components/InfoUsers.astro";
import ImgPresentation from "../components/ImgPresentation.astro";
import CardCarousel from "../components/CardCarousel.astro";
import Carousel from "../components/Carousel.astro";
import StockPlace from "../assets/photos/carousel/stock_place.png";
import Scanner from "../assets/photos/carousel/scanner.png";
import LessStock from "../assets/photos/carousel/less_stock.png";
import ImageCarousel from "../components/ImageCarousel.astro";
import MyCoompy from "../assets/photos/carousel/mycoompy.png";
import MyscanScan from "../assets/photos/carousel/myscanandstock_scan.png";
import MyscanStock from "../assets/photos/carousel/myscanandstock_stock.png";
import ScannerApp from "../assets/photos/carousel/scanner_et_app.png";
import PosterCharlotte from "../assets/video/poster/charlotte.png";
import PosterJeanChristophe from "../assets/video/poster/jean-christophe.png";
import PosterKevin from "../assets/video/poster/kevin.png";
import ContactForm from "../components/ContactForm.astro";

// stats.webp servi depuis public/ (BASE_URL gère le sous-dossier GitHub Pages)
const base = import.meta.env.BASE_URL;
const statsUrl = base.endsWith("/")
  ? base + "stats.webp"
  : base + "/stats.webp";

// Videos testimonials on S3 (like FeaturesTabs) - not versioned in repo.
const S3_VIDEOS = `https://scanandstock-media.s3.eu-west-3.amazonaws.com/videos`;

// Posters optimises via le pipeline Astro : PNG bruts (576-817 Ko), sortie WebP 360x510
const [posterJC, posterCharlotte, posterKevin] = await Promise.all([
  getImage({
    src: PosterJeanChristophe,
    format: "webp",
    width: 360,
    height: 510,
  }),
  getImage({ src: PosterCharlotte, format: "webp", width: 360, height: 510 }),
  getImage({ src: PosterKevin, format: "webp", width: 360, height: 510 }),
]);

const testimonials = [
  {
    src: `${S3_VIDEOS}/testimonial_jean-Christophe.mp4`,
    poster: posterJC.src,
    label: "Témoignage vidéo de Jean-Christophe, utilisateur de Scan & Stock",
    name: "Jean-Christophe Gilbert",
    role: "Chirurgien-dentiste",
  },
  {
    src: `${S3_VIDEOS}/testimonial_charlotte.mp4`,
    poster: posterCharlotte.src,
    label: "Témoignage vidéo de Charlotte, utilisatrice de Scan & Stock",
    name: "Charlotte Farges",
    role: "Chirurgien-dentiste",
  },
  {
    src: `${S3_VIDEOS}/testimonial_Kevin.mp4`,
    poster: posterKevin.src,
    label: "Témoignage vidéo de Kevin, utilisateur de Scan & Stock",
    name: "Cabinet dentaire république",
    role: "Villeneuve-d'Ascq",
  },
];

const carouselCards = [
  {
    src: StockPlace,
    alt: "Espace de stockage dentaire organisé avec les produits Scan&Stock",
    title: "Economisez jusqu’à 20 % sur le poste achat",
    text: "Que ce soit dans des cabinets d’omnipraticien ou de spécialités les utilisateurs de Scan & Stock ont économisé de 16 à 20 % sur leur poste achat l’année où ils l’ont mis en place. Dans les cabinets composés d’une équipe plus importante les économies liées à la mise en place de Scan & Stock sont souvent plus importantes.",
  },
  {
    src: Scanner,
    alt: "Espace de stockage dentaire organisé avec les produits Scan&Stock",
    title: "Diminuez le temps non clinique de vos assistants dentaires",
    text: "Nos assistantes dentaires sont rentables à nos côtés, en salle de soins, pas en salle de stérilisation à gérer les commandes ou à éplucher les catalogues de vépécistes pour retrouver les références d’un produit utilisé il y a 6 mois. Les chirurgiens-dentistes utilisateurs de Scan&Stock ont remarqué qu’en moyenne le temps passé par leurs équipes à gérer les stocks et les commandes est passé de plus d’1h15 par semaine à moins de 20 minutes.",
  },
  {
    src: LessStock,
    alt: "Espace de stockage dentaire organisé avec les produits Scan&Stock",
    title: "Limitez l’empreinte écologique de votre cabinet dentaire",
    text: "Le surstockage et les périmés sont les fléaux de nombreux cabinets dentaires. La peur de manquer ou encore les offres attrayantes de fabricants et fournisseurs entraînent trop souvent des commandes inutiles. Ces commandes (et donc cet argent qui dort !) se retrouvent sur nos étagères ou au fin fond de tiroir parfois jusqu’à ce que leurs dates de péremption soient dépassées ! Pensez à la planète et stoppez le surstockage !",
  },
];

const imageCarousel = [
  { src: ScannerApp, alt: "douchette et application Scan&Stock" },
  { src: MyscanScan, alt: "application MyScan&Stock et scanner" },
  { src: MyscanStock, alt: "application MyScan&Stock et gestion de stock" },
  { src: MyCoompy, alt: "application MyCoompy" },
];
---

<BaseLayout
  title="Scan&Stock | Accueil"
  description="Scan&Stock automatise la gestion des stocks et des commandes de votre cabinet dentaire : inventaires par scan, suivi en temps réel, réapprovisionnement simplifié."
>
  <MainBox>
    <HeroBox>
      <h1 class="title">
        Le logiciel N°1 pour cabinets dentaires 100% en ligne
      </h1>
      <p class="subtitle">
        Optimisez votre temps et votre budget avec le logiciel Scan&Stock !
      </p>

      <div class="parallax-container">
        <!-- Carrés en flottement libre (animation CSS), indépendants du scroll -->
        <div class="deco deco-white deco-white--a" aria-hidden="true"></div>
        <div class="deco deco-white deco-white--b" aria-hidden="true"></div>
        <div class="deco deco-white deco-white--c" aria-hidden="true"></div>
        <img
          class="stats"
          src={statsUrl}
          alt=""
          aria-hidden="true"
          decoding="async"
        />
        <Image class="order" src={Order} alt="" data-parallax-speed="0.18" />
        <Image class="stock" src={Stock} alt="" data-parallax-speed="-0.14" />
        <Image
          class="warning"
          src={Warning}
          alt=""
          data-parallax-speed="0.24"
        />
        <Image
          class="compare"
          src={Compare}
          alt=""
          data-parallax-speed="-0.1"
        />
      </div>

      <ReserveButton />
    </HeroBox>
    <ClientsCarousel />
    <VideoPresentation />

    <GradientTitle as="h2">
      Découvrez <span class="underline">Scan & Stock en vidéo</span>
    </GradientTitle>
    <FeaturesTabs />
  </MainBox>
  <MainBox class="bottom-up">
    <GradientTitle as="h2">
      Une gestion des
      <span class="underline"> stocks et des commandes optimale </span>
    </GradientTitle>
    <p class="text">
      Scan & Stock est un logiciel dentaire créé par un chirurgien-dentiste pour
      les chirurgiens-dentistes. Notre solution a vu le jour en novembre 2021
      lors du congrès de l’ADF. Aujourd’hui, il compte plus de 1 000
      utilisateurs satisfaits répartis en France, en Belgique, en Suisse, dans
      les DOM-TOM, à Monaco et même au Canada. Scan & Stock est un logiciel
      évolutif, chaque année de nouvelles mises à jour sont faites afin de
      répondre aux demandes de nos utilisateurs.
    </p>

    <InfoFeatures />
  </MainBox>
  <InfoUsers />

  <MainBox class="bottom-down">
    <GradientTitle as="h2">
      Une solution <span class="underline"
        >adaptée aux besoins des cabinets dentaires</span
      >
    </GradientTitle>
    <ImgPresentation />
  </MainBox>
  <MainBox>
    <GradientTitle as="h2">
      Les <span class="underline">promesses</span> de Scan & Stock
    </GradientTitle>
    <p class="text">
      Scan & Stock compte aujourd’hui plus de 1000 utilisateurs répartis sur
      plusieurs pays. Ces utilisateurs heureux sont nos meilleurs ambassadeurs !
      En raison des évolutions constantes de notre logiciel, nous ne pouvons
      vous offrir un logiciel de stock gratuit. Cependant, sûr de notre solution
      et des bienfaits qu’elle va vous apporter, notre abonnement vous donne
      droit à un satisfait ou remboursé d’une période de 2 mois.
    </p>
    <div class="promises-zone">
      <!-- Formes décoratives derrière le carrousel -->
      <div
        class="deco deco-blue deco-blue--left"
        aria-hidden="true"
        data-parallax-speed="0.06"
      >
      </div>
      <div
        class="deco deco-teal deco-teal--right"
        aria-hidden="true"
        data-parallax-speed="-0.08"
      >
      </div>
      <div
        class="deco deco-blue deco-blue--right"
        aria-hidden="true"
        data-parallax-speed="0.09"
      >
      </div>

      <Carousel label="Présentation Scan&Stock" withReserveBtn>
        {
          carouselCards.map((card) => (
            <li class="carousel-slide">
              <CardCarousel
                src={card.src}
                alt={card.alt}
                title={card.title}
                text={card.text}
              />
            </li>
          ))
        }
      </Carousel>
    </div>
  </MainBox>

  <Carousel label="Nos outils" variant="image">
    {
      imageCarousel.map((image) => (
        <li class="carousel-slide">
          <ImageCarousel src={image.src} alt={image.alt} />
        </li>
      ))
    }
  </Carousel>

  <MainBox>
    <GradientTitle as="h2"
      >Ils <span class="underline">utilisent Scan & Stock</span></GradientTitle
    >
    <div class="testimonials">
      {
        testimonials.map((testimonial, index) => (
          <figure class="testimonial-card">
            {/* Formes décoratives ancrées à la 1re et à la dernière vidéo */}
            {index === 0 && (
              <div
                class="deco deco-teal deco-teal--testim-left"
                aria-hidden="true"
              />
            )}
            {index === testimonials.length - 1 && (
              <>
                <div
                  class="deco deco-teal deco-teal--testim-top"
                  aria-hidden="true"
                />
                <div
                  class="deco deco-blue deco-blue--testim-right"
                  aria-hidden="true"
                />
              </>
            )}
            <div class="testimonial-media">
              <video
                class="testimonial-video"
                src={testimonial.src}
                poster={testimonial.poster}
                preload="metadata"
                loop
                playsinline
                aria-label={testimonial.label}
                width="360"
                height="510"
              />
            </div>
            <figcaption class="testimonial-caption">
              <span class="testimonial-name">{testimonial.name}</span>
              <span class="testimonial-role">{testimonial.role}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <GradientTitle> Nous contacter</GradientTitle>
    <ContactForm />
  </MainBox>
</BaseLayout>

<style>
  /* ─── Mobile ───────────────────────────────────────────  */
  .title {
    color: white;
    font-size: clamp(20px, 3vw, 40px);
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: white;
    text-align: center;
    font-weight: 400;
    font-size: clamp(12px, 1.5vw, 20px);
  }

  .parallax-container {
    width: 100%;
    position: relative;
    padding: 40px 0;
  }

  .stats {
    padding-top: 20px;
    width: 100%;
    max-width: 700px;
    margin: auto;
  }

  .order {
    position: absolute;
    top: 30px;
    width: clamp(90px, 32%, 220px);
    height: fit-content;
    box-shadow: 4px 4px 38px 0 #00000040;
  }

  .stock {
    position: absolute;
    top: 20px;
    right: 0;
    width: clamp(200px, 64%, 410px);
    height: fit-content;
    box-shadow: 4px 4px 38px 0 #00000040;
  }

  .warning {
    position: absolute;
    bottom: 20px;
    width: clamp(170px, 55%, 250px);
    height: fit-content;
    box-shadow: 4px 4px 38px 0 #00000040;
  }

  .compare {
    position: absolute;
    bottom: 0;
    width: clamp(100px, 30%, 180px);
    right: 30px;
    height: fit-content;
    box-shadow: 4px 4px 38px 0 #00000040;
  }

  /* ─── Formes décoratives hero ─────────────────────────── */
  .deco {
    position: absolute;
    border-radius: 14px;
    filter: blur(2px);
    pointer-events: none;
    will-change: transform;
  }

  .deco-white {
    background: rgba(255, 255, 255, 0.07);
  }

  /* Flottement libre : chaque carré voyage à travers toute la hero box
       (trajets en vw → adaptés à la largeur d'écran) avec une rotation
       complète par cycle. Boucles fermées (100% = 0%) pour un mouvement
       continu sans à-coup. */
  @keyframes deco-roam-a {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    30% {
      transform: translate(-30vw, 8vw) rotate(110deg);
    }
    55% {
      transform: translate(-56vw, 14vw) rotate(200deg);
    }
    80% {
      transform: translate(-22vw, 17vw) rotate(290deg);
    }
    100% {
      transform: translate(0, 0) rotate(360deg);
    }
  }

  @keyframes deco-roam-b {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    30% {
      transform: translate(26vw, -7vw) rotate(-100deg);
    }
    55% {
      transform: translate(50vw, 5vw) rotate(-190deg);
    }
    80% {
      transform: translate(18vw, -11vw) rotate(-280deg);
    }
    100% {
      transform: translate(0, 0) rotate(-360deg);
    }
  }

  @keyframes deco-roam-c {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    30% {
      transform: translate(-34vw, -9vw) rotate(95deg);
    }
    55% {
      transform: translate(-58vw, -3vw) rotate(190deg);
    }
    80% {
      transform: translate(-20vw, -13vw) rotate(285deg);
    }
    100% {
      transform: translate(0, 0) rotate(360deg);
    }
  }

  /* haut-droite, ~140×138 — traverse vers la gauche et le bas */
  .deco-white--a {
    width: clamp(90px, 8vw, 140px);
    height: clamp(88px, 8vw, 138px);
    top: 5%;
    right: 8%;
    animation: deco-roam-a 22s ease-in-out infinite;
  }

  /* milieu-gauche, ~149×145 — traverse vers la droite */
  .deco-white--b {
    width: clamp(90px, 8.6vw, 149px);
    height: clamp(88px, 8.4vw, 145px);
    top: 40%;
    left: 8%;
    animation: deco-roam-b 28s ease-in-out -10s infinite;
  }

  /* bas-droite, ~129×125, légèrement plus opaque — traverse vers la gauche et le haut */
  .deco-white--c {
    background: rgba(255, 255, 255, 0.11);
    width: clamp(80px, 7.5vw, 129px);
    height: clamp(78px, 7.2vw, 125px);
    bottom: 5%;
    right: 10%;
    animation: deco-roam-c 34s ease-in-out -20s infinite;
  }

  .order,
  .stock,
  .warning,
  .compare {
    will-change: transform;
    transform: translateY(var(--parallax-y, 0px));
  }

  /* ─── Formes décoratives carrousel « promesses » ──────── */
  .promises-zone {
    position: relative;
  }

  /* Le carrousel passe au-dessus des formes */
  .promises-zone :global(.carousel-section) {
    position: relative;
    z-index: 1;
  }

  /* Le texte garde la priorité si une forme remonte dessous */
  .text {
    position: relative;
    z-index: 1;
  }

  .deco-blue {
    background: linear-gradient(
      110deg,
      rgba(2, 73, 101, 0.5) 9.7%,
      rgba(65, 119, 140, 0.5) 104%
    );
  }

  .deco-teal {
    background: linear-gradient(
      122deg,
      rgba(18, 161, 154, 0.5) 9.7%,
      rgba(18, 161, 154, 0.25) 104%
    );
    box-shadow: 0 4px 4px rgba(0, 0, 0, 0.25);
  }

  /* Masquées en mobile (les cards occupent ~90% de la largeur) */
  .deco-blue--left,
  .deco-teal--right,
  .deco-blue--right {
    display: none;
  }

  @media screen and (min-width: 768px) {
    /* gauche : 206×470, dépasse du bord gauche du carrousel */
    .deco-blue--left {
      display: block;
      width: clamp(110px, 14%, 210px);
      aspect-ratio: 206 / 470;
      top: 4%;
      left: 1%;
      transform: translateY(var(--parallax-y, 0px)) rotate(-4deg);
    }

    /* haut-droite : 238×365, rotation ~5°, dépasse au-dessus du carrousel */
    .deco-teal--right {
      display: block;
      width: clamp(120px, 16%, 240px);
      aspect-ratio: 238 / 365;
      top: 0px;
      right: 16%;
      transform: translateY(var(--parallax-y, 0px)) rotate(-4deg);
    }

    /* droite : 261×481 */
    .deco-blue--right {
      display: block;
      width: clamp(130px, 17%, 260px);
      aspect-ratio: 261 / 481;
      top: -15px;
      right: 1%;
      transform: translateY(var(--parallax-y, 0px));
    }
  }

  .testimonials {
    display: flex;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
    position: relative;
    margin: 2rem 0;
  }

  /* ─── Formes ancrées aux cartes vidéo (tous écrans) ──────
       Positionnées DANS la 1re et la dernière carte : elles suivent
       les vidéos sur tous les devices. z-index: -1 = derrière la
       vidéo, dans le contexte d'empilement de la carte (z-index: 1). */
  .deco-teal--testim-top,
  .deco-teal--testim-left,
  .deco-blue--testim-right {
    z-index: -1;
    will-change: auto;
  }

  /* coin haut-droit de la dernière vidéo */
  .deco-teal--testim-top {
    width: 200px;
    aspect-ratio: 209 / 348;
    top: -43px;
    right: 19px;
    transform: rotate(-4.97deg);
  }

  /* coin haut-gauche de la 1re vidéo */
  .deco-teal--testim-left {
    width: 105px;
    aspect-ratio: 184 / 347;
    top: 90px;
    left: -23px;
    transform: rotate(-11deg);
  }

  /* coin bas-droit de la dernière vidéo */
  .deco-blue--testim-right {
    width: 160px;
    aspect-ratio: 261 / 481;
    top: -20px;
    right: -35px;
    transform: rotate(13deg);
  }

  .testimonial-card {
    position: relative;
    /* au-dessus des formes décoratives du contact qui débordent vers le haut */
    z-index: 1;
    width: 360px;
    margin: 0;
    border-radius: 35px;
    /* pas d'overflow: hidden : les formes décoratives ancrées à la carte
           doivent pouvoir dépasser ; la vidéo porte son propre border-radius */
  }

  /* Conteneur porteur de l'arrondi : un border-radius directement sur le
       <video> casse le compositing GPU de Chrome Android (poster figé, son OK).
       On clippe via overflow sur le wrapper, la vidéo reste un rectangle plein. */
  .testimonial-media {
    display: block;
    width: 100%;
    height: 510px;
    border-radius: 35px;
    overflow: hidden;
  }

  .testimonial-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000;
    cursor: pointer;
  }

  .testimonial-caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 70px 24px 22px;
    color: #fff;
    text-align: start;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  /* Voile flouté en dégradé : net en bas, s'estompe vers le haut. */
  .testimonial-caption::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    mask-image: linear-gradient(to top, black 0%, black 35%, transparent 100%);
    border-radius: 35px;
  }

  .testimonial-card.is-playing .testimonial-caption {
    opacity: 0;
  }

  .testimonial-name,
  .testimonial-role {
    position: relative;
  }

  .testimonial-name {
    font-weight: 700;
    font-size: 18px;
    line-height: 1.2;
  }

  .testimonial-role {
    font-weight: 400;
    font-size: 14px;
    opacity: 0.9;
  }

  /* ─── TABLET ───────────────────────────────────────────  */
  @media screen and (min-width: 768px) {
    .text {
      max-width: 80%;
      text-align: start;
      margin: auto;
      line-height: 45px;
      font-size: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deco,
    .order,
    .stock,
    .warning,
    .compare {
      will-change: auto;
    }

    /* stoppe le flottement libre des carrés du hero */
    .deco-white--a,
    .deco-white--b,
    .deco-white--c {
      animation: none;
    }
  }

  /* ─── desktop ───────────────────────────────────────────  */
  @media screen and (min-width: 1240px) {
    .parallax-container {
      padding: 0;
    }

    .order {
      top: unset;
      right: 13%;
      bottom: 0;
    }

    .stock {
      top: unset;
      left: 0;
      bottom: 20%;
    }

    .warning {
      bottom: unset;
      right: 5%;
      top: 16%;
    }

    .compare {
      left: 10%;
      top: 15%;
    }
  }
</style>

<script>
  import "../js/parallax";

  const testimonialVideos =
    document.querySelectorAll<HTMLVideoElement>(".testimonial-video");

  // Appareils tactiles (mobile/tablette) : pas de survol possible.
  const isTouch = window.matchMedia("(hover: none), (pointer: coarse)").matches;
  // Respect de prefers-reduced-motion : pas de lecture auto au survol.
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  testimonialVideos.forEach((video) => {
    const card = video.closest(".testimonial-card");

    if (isTouch) {
      // Mobile/tablette : on confie la lecture au lecteur natif. Combiné à
      // `playsinline`, le bouton play natif décode et peint la 1re frame —
      // le poster disparaît correctement (ce que le play() programmatique
      // ne faisait pas sur iOS). Bonus accessibilité : contrôles natifs.
      video.setAttribute("controls", "");
      // La légende (nom/profession) se masque pendant la lecture.
      video.addEventListener("play", () => card?.classList.add("is-playing"));
      video.addEventListener("pause", () =>
        card?.classList.remove("is-playing"),
      );
      return;
    }

    // Desktop : lecture au survol, son activé une fois la lecture lancée.
    const play = () => {
      // Masque le nom/profession pendant la lecture.
      card?.classList.add("is-playing");
      // Sur iOS, play() doit être appelé en premier dans le geste utilisateur,
      // puis on désactive le muet après — l'inverse bloque la lecture.
      video
        .play()
        .then(() => {
          video.muted = false;
        })
        .catch(() => {});
    };

    const stop = () => {
      card?.classList.remove("is-playing");

      video.pause();
      // Recharge la vidéo pour réafficher le poster (et non la 1re frame).
      video.load();
    };

    // Survol = lecture auto, sauf si l'utilisateur a réduit les animations.
    if (!prefersReducedMotion) {
      video.addEventListener("mouseenter", play);
      video.addEventListener("mouseleave", stop);
    }

    // Click desktop : bascule lecture/pause (toujours actif, action volontaire).
    video.addEventListener("click", () => {
      if (video.paused) {
        play();
      } else {
        stop();
      }
    });
  });
</script>
